#!/bin/sh
# discern — local-development wrapper for running the engine from source.
#
# Runs the discern engine from the checkout you are currently inside: it walks up
# from $PWD and execs the first DISCERN checkout's OWN src/main.ts, so a worktree
# runs its own in-progress engine and the main checkout runs main's. Outside any
# discern checkout — e.g. running discern against another project — it falls back
# to $DISCERN_HOME.
#
# A discern checkout is identified by discern's OWN identity in its deno.json
# (`"name": "discern"`), NOT by the bare presence of src/main.ts + deno.json — a
# shape countless Deno projects share. Keying off that shape alone meant running
# this wrapper inside an unrelated, similarly-shaped Deno project execed THAT
# project's src/main.ts as if it were the engine; the is_discern_checkout guard
# below is the single check that keeps the walk-up, the mcp branch, and the
# $DISCERN_HOME fallback all honest.
#
# EXCEPTION — `discern mcp`: the MCP server is the one LONG-LIVED process here, and a
# coding agent (Codex's app-managed-worktree flow) spawns it from INSIDE a worktree.
# Running an ephemeral worktree's engine in a long-lived server is fragile: graduating
# that worktree removes its src/ + templates/ out from under the still-running server
# (the source-relative `resolveTemplatesDir` then can't find templates/). So `mcp`
# alone runs from the MAIN checkout — the worktree's own main repo, found via
# `git worktree list` (the main worktree is its first entry) — which is stable and
# always current (you graduate fixes into it). The gate it then orchestrates still runs
# the WORKTREE's code (its `deno task test`/`fmt` execute at the working root), so
# nothing is lost for dogfooding; only live testing of MCP-server changes themselves
# needs the explicit `deno task dev mcp`. Every other verb stays cwd-aware below.
#
# This is purely a convenience for developing discern itself; it is NOT part of
# user-facing setup and discern's installer never lays it down. Install or update
# it with `deno task install-dev-cli`.

# --- stamped at install time -------------------------------------------------
# install-dev-cli rewrites the next assignment to the main checkout's absolute
# path, giving the INSTALLED shim a durable fallback for when no DISCERN_HOME is
# in the environment — e.g. a GUI-launched agent whose hooks run via /bin/sh and
# never source your shell profile, or cron/CI. It stays empty in the source tree,
# where the cwd walk-up below already covers in-checkout use.
discern_baked_checkout=""
# -----------------------------------------------------------------------------

# True when $1 is the root of a discern engine checkout — not merely a Deno
# project of the same shape. Confirms discern's identity declaration in deno.json
# so an unrelated `src/main.ts` + `deno.json` project is never mistaken for it.
is_discern_checkout() {
  [ -f "$1/src/main.ts" ] || return 1
  [ -f "$1/deno.json" ] || return 1
  grep -Eq '"name"[[:space:]]*:[[:space:]]*"discern"' "$1/deno.json"
}

# Exec the engine that lives in checkout $1, passing the remaining args through.
run_engine() {
  engine_root=$1
  shift
  exec deno run --allow-read --allow-write --allow-env --allow-run \
    --config "$engine_root/deno.json" "$engine_root/src/main.ts" "$@"
}

if [ "$1" = "mcp" ]; then
  main=$(git -C "$PWD" worktree list --porcelain 2>/dev/null |
    sed -n 's/^worktree //p' | head -1)
  if [ -n "$main" ] && is_discern_checkout "$main"; then
    run_engine "$main" "$@"
  fi
  # Not inside a discern checkout (e.g. an external project's MCP from source): fall
  # through to the cwd-walk / $DISCERN_HOME resolution below.
fi

dir=$PWD
while [ "$dir" != "/" ]; do
  if is_discern_checkout "$dir"; then
    run_engine "$dir" "$@"
  fi
  dir=$(dirname "$dir")
done

if [ -n "${DISCERN_HOME:-}" ] && is_discern_checkout "$DISCERN_HOME"; then
  run_engine "$DISCERN_HOME" "$@"
fi

# Last resort: the checkout baked in at install time (empty in the source tree).
# An explicit $DISCERN_HOME above still wins, so you can repoint without
# reinstalling; this only catches the no-env case the fallback exists for.
if [ -n "$discern_baked_checkout" ] && is_discern_checkout "$discern_baked_checkout"; then
  run_engine "$discern_baked_checkout" "$@"
fi

echo "discern: no discern checkout found at or above $PWD, and \$DISCERN_HOME is unset or invalid." >&2
echo "        cd into a discern checkout, or point DISCERN_HOME at your main checkout." >&2
exit 1
