.DS_Store
*.log
/node_modules/
/.idea/gbrowsers.xml

# Compiled CLI binaries produced by `deno task build` / `deno compile`.
/dist/

# Transient public-docs staging dir `deno task build` embeds for `discern docs`
# (removed after each build; ignored so an interrupted build can't dirty the tree).
/.discern-bundled-docs/

# Coverage and scratch output.
/coverage/
/.scratch/

# Vale: ignore the synced style packages (`vale sync` writes Microsoft/,
# proselint/ here), but track the authored sources and committed artifacts —
# the project vocabulary under .vale/config/, the house-voice style under
# .vale/Discern/, and the generated register styles (compiled from
# scripts/brand/vale.ts by `deno task codegen`) are source or committed
# output, not downloads. The `/*` + `!` re-include is required because git
# can't un-ignore a path under a wholesale-ignored dir.
/.vale/*
!/.vale/config/
!/.vale/Discern/
!/.vale/DiscernAgent/
!/.vale/DiscernBrand/
!/.vale/DiscernProduct/

# Public design-system artifacts are emitted from the exact package release by
# `deno task site:build`. Discern's selections and compositions live in
# `site/design_system.ts` and `site/page-src/`; build products never enter Git.
/site/pages/index.html
/site/pages/old.html
/site/pages/lipsum.html
/site/pages/assets/design-system/
/site/pages/fragments/
/site/pages/v2.html

# --- discern ---
# Generated automatically by discern via the bundled .gitignore fragment and provider registry | https://discern.sh
# discern's managed ignore rules: only the skills directories it
# materializes and machine-local provider state. discern owns this
# block alone and never touches your other rules. The compiled agent
# files (AGENTS.md and its mirrors) are tracked, so every agent —
# cloud included — reads them from a fresh clone. For the full list
# of discern-managed files, run `discern docs` or see https://discern.sh
/.claude/skills/
/.claude/settings.local.json
/.agents/skills/
# --- /discern ---
