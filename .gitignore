.DS_Store
*.log

# Compiled CLI binaries produced by `deno task build` / `deno compile`.
/dist/

# Transient public-docs staging dir `deno task build` embeds for `discern help`
# (removed after each build; ignored so an interrupted build can't dirty the tree).
/.discern-help-docs/

# Coverage and scratch output.
/coverage/
/.scratch/

# Vale: ignore the synced style packages (`vale sync` writes Microsoft/,
# proselint/ here), but track the authored config — the project vocabulary
# under .vale/config/ is source, not a download. The `/*` + `!` re-include is
# required because git can't un-ignore a path under a wholesale-ignored dir.
/.vale/*
!/.vale/config/

# --- discern harness ---
# Compiled agent files are generated by `discern refresh` from discern's
# built-in guidance + your [guidance].sources. They are build artifacts, not
# tracked (ADR 0034): the reviewable source is guidance.md + templates/guidance/*,
# which ARE tracked, so guidance changes show up in review as source diffs. A
# stale or hand-edited generated file is caught by `discern finish`'s
# guidance-currency check, not by `git diff`.
/AGENTS.md
/CLAUDE.md
/GEMINI.md
# Everything under .claude/ is generated or ephemeral — the materialized skills
# (.claude/skills/, copied/symlinked by `discern refresh`) and the linked
# worktree checkouts created by the worktree hooks — EXCEPT your settings, which
# are tracked. (Leaving the worktree checkouts tracked would make the main
# checkout read "dirty" the moment a worktree is created, blocking graduation.)
/.claude/*
!/.claude/settings.json
!/.claude/settings.local.json
/.agents/skills/

# Local clean-room setup eval transcripts. They contain machine paths and agent
# output, so they must never be committed.
/scripts/setup-eval/results/
