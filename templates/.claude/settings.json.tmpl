{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./bin/agent worktree:ensure",
            "timeout": 600
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'set -e; input=$(cat); name=$(printf %s \"$input\" | jq -r .name); cwd=$(printf %s \"$input\" | jq -r .cwd); dir=\"$cwd/.claude/worktrees/$name\"; if [ ! -e \"$dir/.git\" ]; then git -C \"$cwd\" worktree add \"$dir\" -b \"{{branch_prefix}}$name\" 1>&2; fi; (cd \"$dir\" && ./bin/agent worktree 1>&2); printf %s \"$dir\"'"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'input=$(cat); dir=$(printf %s \"$input\" | jq -r .worktree_path); (cd \"$dir\" && ./bin/agent worktree:teardown 1>&2) || true'"
          }
        ]
      }
    ]
  }
}
