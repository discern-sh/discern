# icculus.toml — the one file that teaches a stack-neutral harness about YOUR
# project. The engine under .icculus/engine/ is generic; everything specific to
# your language and tools lives here. Edit this by hand; re-run `icculus
# upgrade` to refresh the engine without touching this file.
#
# Generated by icculus {{kit_version}} for "{{project_name}}".

[project]
# Short, lowercase, dash-separated identity. Used for worktree/site/branch names.
slug = "{{project_slug}}"

# Branch prefix for worktrees created by the harness, e.g. "agent/my-feature".
branch_prefix = "{{branch_prefix}}"

# The integration branch the gate merges into and worktrees graduate onto.
# Override per-invocation with the MAIN_BRANCH env var.
main_branch = "main"

# Which agent instruction files `agent guidelines` compiles from .ai/guidelines/.
# Known targets: "claude_code" -> CLAUDE.md, "codex" -> AGENTS.md.
agents = [{{agents_array}}]

# Where the gate points an agent when a phase fails in a non-obvious way. Keep
# this doc current with the traps specific to your stack (see the comment block
# the gate prints on failure). Empty disables the pointer.
gotchas_doc = "{{gotchas_doc}}"


# ─────────────────────────────────────────────────────────────────────────────
# [slots] — the stack-specific commands the gate runs. Each slot is one shell
# command (chain with && for multiple tools). The default ":" is a no-op that
# always passes, so a fresh install has a green gate you fill in over time. Run
# `/bootstrap` to have your coding agent propose fills by sniffing the repo.
#
# `phase` decides WHEN and HOW the command runs inside `agent finish`:
#   fix       mutating fixers (formatter, codemod). Run first, in parallel with
#             `build`. Must leave the tree in the state checks/tests will see.
#   build     produce artifacts later phases read (compile, bundle assets).
#             Runs in parallel with `fix`.
#   check     read-only analysis (linter, type-checker). Runs after fix+build,
#             in parallel with `test`.
#   test      the test suite. Runs in parallel with `check`.
#   coverage  slow coverage measurement. NOT part of `agent finish`; run on
#             demand via `agent finish:coverage` (enforces [ratchets]).
#
# `agent tidy` is the fast inner loop: it runs the `fix` slots then the `check`
# slots, and never builds or tests. Add or remove slots freely — the engine
# discovers them by name; only `phase` and `run` matter.
# ─────────────────────────────────────────────────────────────────────────────

[slots.format]
phase = "fix"
run   = ":"   # e.g. "prettier --write ." or "ruff format ." or "gofmt -w ."

[slots.build]
phase = "build"
run   = ":"   # e.g. "npm run build" or "cargo build"

[slots.lint]
phase = "check"
run   = ":"   # e.g. "eslint ." or "ruff check ." or "golangci-lint run"

[slots.typecheck]
phase = "check"
run   = ":"   # e.g. "tsc --noEmit" or "mypy ."

[slots.test]
phase = "test"
run   = ":"   # e.g. "npm test" or "pytest" or "go test ./..."

[slots.coverage]
phase = "coverage"
run   = ":"   # e.g. "npm run coverage" — measured by `agent finish:coverage`


# ─────────────────────────────────────────────────────────────────────────────
# [scopes] — which parts of the repo a change touches. The gate uses this to
# skip irrelevant work (a docs-only change runs no side gate, gets no preview)
# and to fire side gates only when their area changed. Classification fails
# OPEN: a path matching nothing counts as a real code change, so an unknown
# path runs MORE gates, never fewer. Globs use ** for "any depth".
# ─────────────────────────────────────────────────────────────────────────────

[scopes]
# Paths that need no gate at all: docs and agent-guidance sources. (Generated
# guidance outputs are refreshed by the gate itself; editing the source changes
# no behaviour.) Root-level *.md is always treated as neutral.
neutral = [{{scopes_neutral}}]

# Paths that represent real, gated code changes.
web = [{{scopes_web}}]

# The subset of code changes a person could see — worth a preview link.
previewable = [{{scopes_previewable}}]

# Side gates: scope-name -> command run by `agent finish` when that scope
# changed. Define a custom scope by adding `<name> = [globs]` under [scopes]
# above, then map it here. Example: a native sub-app with its own gate.
[scopes.side_gates]
# native = "make -C native check"


# ─────────────────────────────────────────────────────────────────────────────
# [worktree] — the isolated-worktree workflow. The git mechanics are generic;
# the two adapter seams (database, dev-server) are empty by default, so a
# worktree round is a clean no-op until you wire them to your stack.
# ─────────────────────────────────────────────────────────────────────────────

[worktree]
enabled = true

# Environment values copied from the main checkout's .env into a new worktree's
# .env (secrets a fresh worktree needs but that aren't in version control).
inherit_env = []   # e.g. ["APP_KEY", "OPENAI_API_KEY"]

# Give each worktree a deterministic dev-server port (hashed from its id) so
# concurrent worktrees never collide. Read it with `agent worktree-name --port`.
port = true

# Database adapter. Each worktree gets its own database so tests never clash.
# {{db}} expands to the worktree's derived database name. Leave empty for a
# project with no database. (The example below uses a Postgres template DB.)
[worktree.db]
clone = ""   # e.g. "createdb -T {{project_slug}}_template {{db}}"
drop  = ""   # e.g. "dropdb --if-exists {{db}}"

# Dev-server adapter — link/unlink a per-worktree site (a Docker vhost, an ngrok
# tunnel, a reverse-proxy entry, …). Leave empty for none.
[worktree.dev_server]
link   = ""
unlink = ""

# Post-create setup: commands run once after a worktree is created (install
# deps, run migrations, warm caches). Run in order.
[worktree.setup]
steps = []   # e.g. ["npm ci", "npm run build"]


# ─────────────────────────────────────────────────────────────────────────────
# [ratchets] — never-loosen quality floors enforced by the gate.
# ─────────────────────────────────────────────────────────────────────────────

[ratchets]
# Minimum line coverage, enforced by `agent finish:coverage`. The check fails if
# coverage drops below this OR if this value is lower than on the main branch —
# so the floor only ever rises. 0.0 disables it until you set a real floor.
coverage_min = 0.0

# Named metric ratchets generalise the coverage idea to ANY number you want to
# only-ever-improve: lint/type-error counts, bundle size, a perf budget. Run them
# all with `agent finish:ratchets` (slow; on demand, like finish:coverage).
#
# A slot reports a metric by printing a line:   ICCULUS_METRIC <name> <number>
# (the LAST such line wins). The coverage ratchet also accepts a trailing "NN%".
#
# Each [ratchets.<name>] declares:
#   metric     the metric name a slot emits        (default: the ratchet name)
#   direction  "up"   value should rise; limit is a FLOOR   (like coverage)
#              "down" value should fall; limit is a CEILING (like a size budget)
#   limit      the floor/ceiling — compared vs main, so a floor may only rise and
#              a ceiling may only fall (you can't loosen the gate on a branch)
#   slot       the [slots.<name>] whose output emits the metric
#
# Example — keep a bundle under 500 kB, measured by a "bundlesize" slot:
# [slots.bundlesize]
# phase = "coverage"   # the on-demand phase, so a normal `finish` won't run it
# run   = "printf 'ICCULUS_METRIC bundle_bytes %s\\n' \"$(wc -c < dist/app.js)\""
#
# [ratchets.bundle]
# metric    = "bundle_bytes"
# direction = "down"
# limit     = 500000
# slot      = "bundlesize"


# ─────────────────────────────────────────────────────────────────────────────
# [evidence] — optional gate requiring each branch to record work evidence
# (e.g. a screenshot or a note) before `agent finish` passes. Off by default.
# ─────────────────────────────────────────────────────────────────────────────

[evidence]
enabled = false
capture = ""   # command that records evidence for the current branch


# ─────────────────────────────────────────────────────────────────────────────
# [recipes] — your OWN agent commands. Drop an executable script carrying a
# `# desc: ...` line into the directory below and it becomes a first-class
# `agent <name>` command, listed by `agent --help` under "Project recipes". This
# directory is yours: never managed, never refreshed by `icculus upgrade`. A name
# that collides with a built-in engine recipe (finish, worktree:*, …) is ignored
# with a warning — the engine always wins, so a project file can never redefine
# the core gate. A recipe run via `agent <name>` can source the engine library
# (`. "$ICCULUS_LIB/bootstrap.sh"`) for config_get / info / ok / die / run_parallel.
# ─────────────────────────────────────────────────────────────────────────────

[recipes]
# Where your recipes live, relative to the project root. The default works with
# no config at all; point it elsewhere (e.g. "tools/") if you prefer.
dir = ".icculus/recipes"
