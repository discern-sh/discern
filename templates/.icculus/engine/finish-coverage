#!/usr/bin/env sh
# desc: the coverage ratchet — never below the floor, never lowered vs main
. "$(dirname "$0")/lib/bootstrap.sh"

# finish-coverage (dispatched as `agent finish:coverage`) — the rising-floor
# coverage ratchet. It is intentionally NOT part of `agent finish`: coverage
# measurement is slow, so it runs on demand before pushing.
#
# Coverage is now ONE instance of the general named-metric ratchet engine (see
# lib/ratchets.sh and ADR 0003): direction "up", limit [ratchets].coverage_min,
# metric "coverage", measured by the coverage-phase slots. Its behaviour is
# unchanged — including the legacy fallback that reads the last "NN%" the slot
# prints when no `ICCULUS_METRIC coverage <n>` line is emitted, and the
# disabled-at-0 floor. Run `agent finish:ratchets` to hold every ratchet at once.

# shellcheck source=lib/ratchets.sh
. "$ICCULUS_LIB/ratchets.sh"

ratchet_check coverage
exit $?
