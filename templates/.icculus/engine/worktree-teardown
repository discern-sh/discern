#!/usr/bin/env sh
# desc: tear down this worktree's database + dev-server link (for discarding it)
. "$(dirname "$0")/lib/bootstrap.sh"

# worktree-teardown — release the external resources a worktree holds, without
# graduating its branch. Used when DISCARDING a worktree (the branch is not
# wanted) rather than handing it back. To graduate instead, use
# `agent worktree:exit`, which tears down AND moves the branch into main.
#
#   assert in a linked worktree
#   -> unlink the dev server   [worktree.dev_server].unlink
#   -> drop the database       [worktree.db].drop
#
# Both steps are clean no-ops when their adapter command is unset.

set -eu

# wt_teardown lives in the shared worktree helpers.
# shellcheck source=lib/worktree.sh
. "$ICCULUS_LIB/worktree.sh"

"$ICCULUS_ENGINE/assert-in-worktree" 'agent worktree:teardown' >/dev/null \
    || die "agent worktree:teardown must be run from inside a linked git worktree, not the main checkout."

heading "Tearing down this worktree…"
wt_teardown
ok "Worktree teardown complete."
