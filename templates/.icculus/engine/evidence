#!/usr/bin/env sh
# desc: capture/check optional per-branch work evidence (off unless enabled)
. "$(dirname "$0")/lib/bootstrap.sh"

# evidence <capture|check> [args...]
#
# A dependency-free generalisation of the donor's agent work-evidence gate.
# Evidence is a small record proving the branch's work was actually exercised
# (a note, a screenshot path, whatever [evidence].capture produces). The gate is
# OFF by default; turn it on with [evidence].enabled = true.
#
# Storage is the filesystem, not a database: one directory per branch under
#   $ICCULUS_ROOT/.icculus/evidence/<branch-slug>/
# holding timestamped marker files. That tree is gitignored (runtime, not
# source) by the shipped .gitignore fragment.
#
# Subcommands:
#   capture [note...]   Record evidence for the current branch. Runs
#                       [evidence].capture when set; otherwise writes a marker
#                       file containing the note (or a default line).
#   check               Used by `agent finish` as a pre-flight. When the gate is
#                       enabled, fail unless fresh evidence exists for the
#                       branch (newer than the latest code change, mirroring the
#                       donor's freshness rule). No-op (exit 0) when disabled.

git_bin=${GIT_BIN:-git}
evidence_root="$ICCULUS_ROOT/.icculus/evidence"

# --- helpers --------------------------------------------------------------

# Current branch name, or empty on detached HEAD / no git.
current_branch() {
    command -v "$git_bin" >/dev/null 2>&1 || return 0
    _cb=$("$git_bin" rev-parse --abbrev-ref HEAD 2>/dev/null) || return 0
    [ "$_cb" = "HEAD" ] && return 0
    printf '%s' "$_cb"
}

# Filesystem-safe slug for a branch name (e.g. "feat/x" -> "feat-x").
branch_slug() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's#[^a-z0-9]+#-#g; s/^-+//; s/-+$//'
}

# Newest mtime (epoch seconds) among a branch's evidence files, or empty.
latest_evidence_mtime() {
    _le_dir=$1
    [ -d "$_le_dir" ] || return 0
    # Portable: stat's flags differ across platforms, so let find sort by time.
    find "$_le_dir" -type f -exec ls -t {} + 2>/dev/null | head -n 1 | while IFS= read -r _f; do
        epoch_mtime "$_f"
    done
}

# mtime of a path in epoch seconds, tolerant of BSD vs GNU stat.
epoch_mtime() {
    stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || printf ''
}

# Newest mtime (epoch seconds) among the branch's changed source files, so we
# can require evidence to be at least as new. Empty when nothing/none resolve.
latest_change_mtime() {
    command -v "$git_bin" >/dev/null 2>&1 || return 0
    _lc_newest=""
    "$git_bin" status --porcelain=v1 --untracked-files=all 2>/dev/null \
        | cut -c4- \
        | sed 's/.* -> //; s/^"//; s/"$//' \
        | while IFS= read -r _cf; do
            [ -n "$_cf" ] && [ -f "$ICCULUS_ROOT/$_cf" ] || continue
            epoch_mtime "$ICCULUS_ROOT/$_cf"
        done | sort -nr | head -n 1
}

# --- subcommands ----------------------------------------------------------

cmd=${1:-check}
[ "$#" -ge 1 ] && shift

case "$cmd" in
    capture)
        branch=$(current_branch)
        [ -n "$branch" ] || die "evidence capture: no git branch resolved (detached HEAD?)."

        custom=$(config_get evidence.capture "")
        if [ -n "$custom" ]; then
            # Delegate to the project's own capture command. It owns what
            # evidence means and where it lands; we just run it.
            info "Capturing evidence via [evidence].capture..."
            eval "$custom" || die "evidence capture: [evidence].capture command failed."
            ok "Evidence captured for branch '$branch'."
            exit 0
        fi

        # No custom command: write a simple marker file ourselves.
        dir="$evidence_root/$(branch_slug "$branch")"
        mkdir -p "$dir" || die "evidence capture: could not create $dir."
        stamp=$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null || date +%s)
        file="$dir/$stamp.txt"
        note=$*
        [ -n "$note" ] || note="Work evidence recorded for branch '$branch'."
        {
            printf 'branch: %s\n' "$branch"
            printf 'recorded_at: %s\n' "$stamp"
            printf 'note: %s\n' "$note"
        } > "$file" || die "evidence capture: could not write $file."
        ok "Evidence recorded at $file"
        exit 0
        ;;

    check)
        # Disabled gate -> always pass. This is the common case.
        config_bool evidence.enabled || exit 0

        branch=$(current_branch)
        if [ -z "$branch" ]; then
            warn "evidence check: no git branch resolved; skipping the evidence gate."
            exit 0
        fi

        dir="$evidence_root/$(branch_slug "$branch")"
        newest=$(latest_evidence_mtime "$dir")

        if [ -z "$newest" ]; then
            {
                printf 'No work evidence recorded for branch "%s".\n' "$branch"
                printf 'Capture it before finishing:\n'
                printf '  agent evidence capture "<what you changed / verified>"\n'
                printf 'Then re-run the gate. (Disable entirely with [evidence].enabled = false.)\n'
            } >&2
            exit 1
        fi

        # Freshness: evidence must be at least as new as the latest code change,
        # so a stale record from before the work cannot satisfy the gate.
        change_mtime=$(latest_change_mtime)
        if [ -n "$change_mtime" ] && [ "$newest" -lt "$change_mtime" ] 2>/dev/null; then
            {
                printf 'Work evidence for branch "%s" is older than your latest change.\n' "$branch"
                printf 'Re-capture it before finishing:\n'
                printf '  agent evidence capture "<what you changed / verified>"\n'
            } >&2
            exit 1
        fi

        exit 0
        ;;

    -h|--help)
        printf 'Usage: evidence <capture|check> [args...]\n'
        exit 0
        ;;

    *)
        die "evidence: unknown subcommand '$cmd' (expected capture or check)."
        ;;
esac
