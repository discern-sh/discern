#!/usr/bin/env sh
# desc: the full quality gate — fix+build, then check+test, scope gates, merge
. "$(dirname "$0")/lib/bootstrap.sh"

# finish — run everything before handing work back: apply fixers and build
# artifacts, then run read-only checks alongside the test suite, fire any scope
# gates whose scope changed, and finally confirm the branch carries main.
#
# Stack-specific commands are read from [capabilities] and [checks], not
# hardcoded. A known capability's STAGE is derived from its name (format->fix,
# build->build, lint/typecheck->check, test->test); a [checks.<name>] names its
# stage explicitly. The stage order is:
#
#   fix                   run_serial over the fix-stage jobs (ordered, mutating)
#   build                 run_parallel over the build-stage jobs
#   check ∥ test          run_parallel over the check + test-stage jobs
#   scope gates           run each [scopes.<name>].gate for a changed scope
#   assert-main-merged    confirm the branch carries main (when present)
#   ratchet reminder      print when any [ratchets.<name>] is configured
#   preview line          print when a previewable scope changed and a link is set
#
# Each job (a capability or a check) runs as its OWN labelled job, so a failure —
# and the --json report — is attributed to the precise capability/check, not a
# whole stage. The mutating fix jobs run serially in declaration order; build
# runs after fix; check and test run together. On any failure in the GATED
# stages, an EXIT trap prints the gotchas pointer (single-sourced from
# lib/gotchas.sh, shared with `with-gotchas`) and the exact exit code preserved.

# shellcheck source=lib/gotchas.sh
. "$ICCULUS_LIB/gotchas.sh"

# --- arguments ------------------------------------------------------------

# --json emits a single machine-readable object on stdout (per-job and
# per-scope-gate result, durations, scopes changed, the failed stage) with all
# human output routed to stderr. See ADR 0004.
as_json=0
case "${1:-}" in
    --json) as_json=1 ;;
    -h | --help) printf 'Usage: finish [--json]\n'; exit 0 ;;
    "") ;;
    *) die "finish: unknown argument '$1'." ;;
esac

# In --json mode, collect each job/scope-gate result through run_parallel's
# structured side channel, and redirect stdout -> stderr so only the final JSON
# lands on real stdout (saved on fd 3). Human mode leaves stdout untouched.
JOBS_RESULTS=""
if [ "$as_json" -eq 1 ]; then
    JOBS_RESULTS=$(mktemp "${TMPDIR:-/tmp}/icculus-finish.XXXXXX") || die "finish: mktemp failed."
    export ICCULUS_JOBS_RESULTS="$JOBS_RESULTS"
    # shellcheck source=lib/validate.sh
    . "$ICCULUS_LIB/validate.sh"   # validate_json_escape for scope names
    exec 3>&1 1>&2
fi

# --- gotchas pointer + JSON report on exit --------------------------------

# Set to 1 only while a gated stage is running; the EXIT trap prints the pointer
# only when we die during one of those stages (not on a clean exit, and not
# during the informational tail). In --json mode the pointer is suppressed — the
# JSON object is the machine-readable guidance.
in_gated_phase=0

on_exit() {
    _oe_code=$?
    [ -n "$JOBS_RESULTS" ] && rm -f "$JOBS_RESULTS"
    if [ "$_oe_code" -ne 0 ] && [ "$in_gated_phase" -eq 1 ] && [ "$as_json" -ne 1 ]; then
        gotchas_hint
    fi
    exit "$_oe_code"
}
trap on_exit EXIT

# Emit the JSON gate report to the saved stdout (fd 3). $1 is the exit code (0 =
# ok), $2 the failed-stage name (empty on success). Reports per-JOB results (the
# execution unit — each capability/check runs as its own job) and per-scope-gate
# results, plus the scopes that changed.
emit_json_report() {
    _ej_ok=$([ "$1" -eq 0 ] && printf 'true' || printf 'false')
    _ej_stage=${2:-}

    # Per-job results, in stage order then declaration order. Each job is keyed in
    # the results file by its label (the same label jobs_in_stage produced); a job
    # with no result line was "skipped" (its stage aborted before it ran — a failed
    # serial fixer, or a fail-fast cancellation). A no-op gate lists no jobs at all.
    _ej_jobs=""
    for _ej_st in $ICCULUS_STAGE_ORDER; do
        while IFS="$(printf '\t')" read -r _ej_lbl _ej_cmd _ej_kind; do
            [ -n "$_ej_lbl" ] || continue
            _ej_line=$(awk -F'\t' -v l="$_ej_lbl" '$1 == l { print $2 " " $3; exit }' "$JOBS_RESULTS" 2>/dev/null)
            if [ -n "$_ej_line" ]; then
                _ej_code=${_ej_line% *}
                _ej_dur=${_ej_line#* }
                [ "$_ej_code" = "0" ] && _ej_status="ok" || _ej_status="failed"
            else
                _ej_status="skipped"
                _ej_dur=0
            fi
            _ej_nm=$(validate_json_escape "$_ej_lbl")
            _ej_jobs="${_ej_jobs:+$_ej_jobs,}$(printf '{"name":"%s","kind":"%s","stage":"%s","status":"%s","duration_s":%s}' "$_ej_nm" "$_ej_kind" "$_ej_st" "$_ej_status" "${_ej_dur:-0}")"
        done <<EOF
$(jobs_in_stage "$_ej_st")
EOF
    done

    # Scope gates: fired ones from the results file, plus configured-but-unchanged
    # ones as "skipped" — the what-ran-vs-skipped-by-scope view.
    _ej_gates=""
    for _ej_scope in $(config_subsections scopes); do
        _ej_cmd=$(config_get "scopes.$_ej_scope.gate" "")
        [ -n "$_ej_cmd" ] || continue
        _ej_line=$(awk -F'\t' -v l="scope:$_ej_scope" '$1 == l { print $2 " " $3; exit }' "$JOBS_RESULTS" 2>/dev/null)
        if [ -n "$_ej_line" ]; then
            _ej_code=${_ej_line% *}
            _ej_dur=${_ej_line#* }
            _ej_status=$([ "$_ej_code" = "0" ] && printf 'ok' || printf 'failed')
        else
            _ej_status="skipped"
            _ej_dur=0
        fi
        _ej_sc=$(validate_json_escape "$_ej_scope")
        _ej_gates="${_ej_gates:+$_ej_gates,}$(printf '{"scope":"%s","status":"%s","duration_s":%s}' "$_ej_sc" "$_ej_status" "${_ej_dur:-0}")"
    done

    _ej_changed=$("$ICCULUS_ENGINE/changed-scopes" --json 2>/dev/null || printf '[]')
    if [ -n "$_ej_stage" ]; then
        _ej_stage_json="\"$_ej_stage\""
    else
        _ej_stage_json="null"
    fi

    printf '{"ok":%s,"jobs":[%s],"scope_gates":[%s],"scopes_changed":%s,"failed_stage":%s}\n' \
        "$_ej_ok" "$_ej_jobs" "$_ej_gates" "$_ej_changed" "$_ej_stage_json" >&3
}

# End the run: in --json mode emit the report; always exit with $1. $2 = failed
# stage (empty on success).
finish_done() {
    [ "$as_json" -eq 1 ] && emit_json_report "$1" "${2:-}"
    exit "$1"
}

# A gated stage failed. In --json mode emit the report and exit; otherwise die
# with the human message. in_gated_phase stays 1 so the EXIT trap adds the gotchas
# pointer (the trap suppresses it in --json mode, where the JSON is the guidance).
fail_phase() {
    [ "$as_json" -eq 1 ] && finish_done 1 "$2"
    die "$1"
}

# --- gate ergonomics (ADR 0006) -------------------------------------------
#
# fail_fast defaults ON: an agent-driven gate wants to abort the moment a job
# fails, not burn wall-clock finishing a slow sibling. Set [gate].fail_fast =
# false to run every job to completion (and see all failures at once). stream
# stays opt-in (live interleaved output trades legibility for immediacy). Read
# once and exported, so they apply to every parallel stage, scope gates included.
#
# Set BOTH ways (export when on, unset when off) so THIS project's config always
# wins — never an inherited value. A `finish` run nested inside another gate (the
# test suite shells out to `agent finish`) would otherwise inherit the parent's
# exported setting and ignore its own [gate] config.
if config_bool gate.stream; then export ICCULUS_GATE_STREAM=1; else unset ICCULUS_GATE_STREAM; fi
if [ "$(config_get gate.fail_fast true)" != "false" ]; then
    export ICCULUS_GATE_FAIL_FAST=1
else
    unset ICCULUS_GATE_FAIL_FAST
fi

# --- fix (serial, mutating) -----------------------------------------------
#
# Each job is its own labelled job (the bare capability/check name). The fix-stage
# jobs run one at a time, in jobs_in_stage order, because they mutate the tree and
# a later fixer may depend on an earlier one's edits. An empty stage is skipped.
# The here-doc (not a pipe) keeps the positional-arg builder in this shell.

set --
while IFS="$(printf '\t')" read -r _lbl _cmd _kind; do
    [ -n "$_lbl" ] || continue
    set -- "$@" "$_lbl" "$_cmd"
done <<EOF
$(jobs_in_stage fix)
EOF
if [ "$#" -gt 0 ]; then
    heading "Applying fixers..."
    in_gated_phase=1
    run_serial "$@" || fail_phase "The fix stage failed." "fix"
    in_gated_phase=0
fi

# --- build (parallel) -----------------------------------------------------

set --
while IFS="$(printf '\t')" read -r _lbl _cmd _kind; do
    [ -n "$_lbl" ] || continue
    set -- "$@" "$_lbl" "$_cmd"
done <<EOF
$(jobs_in_stage build)
EOF
if [ "$#" -gt 0 ]; then
    heading "Building artifacts..."
    in_gated_phase=1
    run_parallel "$@" || fail_phase "The build stage failed." "build"
    in_gated_phase=0
fi

# --- check + test (parallel together) -------------------------------------
#
# Read-only checks and the test suite are independent, so they run concurrently
# — after build, so both see its artifacts. Both stages feed one run_parallel.

set --
for _stage in check test; do
    while IFS="$(printf '\t')" read -r _lbl _cmd _kind; do
        [ -n "$_lbl" ] || continue
        set -- "$@" "$_lbl" "$_cmd"
    done <<EOF
$(jobs_in_stage "$_stage")
EOF
done
if [ "$#" -gt 0 ]; then
    heading "Checking and testing..."
    in_gated_phase=1
    run_parallel "$@" || fail_phase "The check/test stage failed." "check/test"
    in_gated_phase=0
fi

# --- scope gates (run a scope's gate when that scope changed) -------------

# A [scopes.<name>] may carry a `gate` command — the way a sub-component with its
# OWN self-contained gate plugs into `agent finish` (e.g. a native sub-app gating
# its own build). Each fires only when the branch actually changed that scope.
# They run with the SAME model as the stages above: every fired gate runs
# concurrently via run_parallel, output grouped and labelled `scope:<name>`, and a
# single failure fails the gate (all gates still run, so you see every failure at
# once). They run AFTER the main stages, so a gate may rely on fix/build having
# completed. See ADR 0018 (folds in the former side gates of ADR 0002).
changed=$("$ICCULUS_ENGINE/changed-scopes" 2>/dev/null || printf '')
# Collect the fired gates into a label/command argument list. `set --` makes each
# (label, command) a discrete positional pair, so a command containing spaces
# survives intact into run_parallel. `finish` takes no arguments of its own, so
# reusing the positional params here is safe.
set --
for scope in $(config_subsections scopes); do
    gate_cmd=$(config_get "scopes.$scope.gate" "")
    [ -n "$gate_cmd" ] || continue   # a scope without a gate: nothing to fire
    # Did this scope change? (substring test against the newline list)
    case "
$changed
" in
        *"
$scope
"*) ;;
        *) continue ;;
    esac
    set -- "$@" "scope:$scope" "$gate_cmd"
done
if [ "$#" -gt 0 ]; then
    heading "Running gates for changed scopes..."
    in_gated_phase=1
    run_parallel "$@" || fail_phase "One or more scope gates failed." "scope_gates"
    in_gated_phase=0
fi

# --- merge check (worktree support, optional) -----------------------------

# assert-main-merged is provided by the worktree recipe set. It is a no-op in
# the main checkout and fails only when the branch is behind main. Guarded so
# finish works even when worktree support is not installed.
if [ -x "$ICCULUS_ENGINE/assert-main-merged" ]; then
    in_gated_phase=1
    "$ICCULUS_ENGINE/assert-main-merged" || fail_phase "Integrate main, then re-run finish." "merge"
    in_gated_phase=0
fi

# --- success --------------------------------------------------------------

# In --json mode the machine report IS the whole output: emit it and stop before
# the human informational tail below.
[ "$as_json" -eq 1 ] && finish_done 0

# --- informational tail ---------------------------------------------------
#
# Past this point nothing is gated: failures below must not abort the gate (the
# work already passed), so the tail only prints guidance.

# How much of the gate was real? `cmds_in_stage` returns exactly ":" for a stage
# with no real job, so a stage is a no-op precisely when it equals ":". An empty
# gate (all four stages no-op) ran nothing — saying "everything passed" would be
# false confidence, so we say so plainly and keep exit 0 (an unfilled gate is not
# a failure). When only some stages are no-ops, the gate did real work; we still
# nudge once about the unfilled ones.
unfilled_stages=0
for _stage in $ICCULUS_STAGE_ORDER; do
    [ "$(cmds_in_stage "$_stage")" = ":" ] && unfilled_stages=$((unfilled_stages + 1))
done

if [ "$unfilled_stages" -eq 4 ]; then
    ok "Gate passed — but no capability or check is wired, so nothing was actually checked (a no-op gate)."
    warn "Add [capabilities] (format/lint/typecheck/test/build) to .icculus/config.toml — or run /bootstrap."
else
    ok "Everything built and all checks passed."
    if [ "$unfilled_stages" -gt 0 ]; then
        info "${C_DIM}note: $unfilled_stages of 4 gate stages have no command yet.${C_RESET}"
    fi
    info "If you changed something meaningful, update the docs to match before you finish."
fi

# Ratchet reminder: ratchets (coverage, bundle size, lint counts, …) are slow, so
# they run on demand via `agent ratchets`, not as part of finish. Nudge once when
# any [ratchets.<name>] is configured.
if config_subsections ratchets | grep -q .; then
    info "Before pushing, hold the ratchets: ${C_BOLD}agent ratchets${C_RESET} (slow, so not part of finish)."
fi

# Preview line: only when a previewable scope changed AND a dev-server link is
# configured. Informational only — we surface whatever the worktree recipes can
# tell us about this worktree's served site/port, guarded by existence checks.
if [ -n "$(config_get worktree.dev_server.link '')" ] \
    && "$ICCULUS_ENGINE/changed-scopes" --has previewable 2>/dev/null; then
    site=""
    port=""
    if [ -x "$ICCULUS_ENGINE/worktree-name" ]; then
        site=$("$ICCULUS_ENGINE/worktree-name" --site 2>/dev/null || printf '')
        port=$("$ICCULUS_ENGINE/worktree-name" --port 2>/dev/null || printf '')
    fi
    if [ -n "$site" ]; then
        info "Preview this worktree at its dev-server site: ${C_BOLD}${site}${C_RESET}"
    elif [ -n "$port" ]; then
        info "Preview this worktree at its dev-server port: ${C_BOLD}${port}${C_RESET}"
    else
        info "A previewable change landed — start this worktree's dev server to view it."
    fi
fi
