#!/usr/bin/env bash
# helper: remove a git worktree robustly, leaving no orphaned directory

# Remove a git worktree deterministically, leaving no orphaned directory —
# wherever the worktree lives. Different agents keep worktrees in different
# places (a tool-specific folder, or an external path). This works for all of
# them, because its safety boundary is git's own knowledge of what is a
# worktree, not a hard-coded path.
#
# Plain `git worktree remove` is not reliable here: a live process (a dev server
# serving the worktree's site, a test run writing into a build/cache dir) can
# drop a new file into a directory git has just emptied, so the final rmdir
# fails with ENOTEMPTY ("Directory not empty"). Such files are typically
# gitignored, so `git status` looks clean and the failure seems random. Worse,
# that failure PARTIALLY APPLIES: git deregisters the worktree but leaves the
# directory on disk, and nothing else cleans it up — a silent multi-hundred-MB
# leak.
#
# This helper makes removal robust and idempotent:
#   1. Retry `git worktree remove --force` (the race is transient).
#   2. Fall back to `rm -rf` + `git worktree prune` so a directory is NEVER left
#      orphaned and git's metadata is always reconciled.
#
# Quiescing a live dev server before deletion is the dev-server adapter's job:
# the lifecycle recipes run [worktree.dev_server].unlink before calling this, so
# the "stop the writer, then delete" ordering is preserved through the seam.
#
# Usage: remove-worktree-safely <worktree-path>
#
# Safety boundary (location-independent): it only deletes a path that git
# currently lists as a worktree, OR that carries a .git gitlink pointing into
# THIS repository's worktrees admin area (a deregistered orphan of this repo).
# Anything else — and the main checkout — is refused, so a stray argument can
# never rm -rf arbitrary data.
#
# Honors GIT_BIN (default "git").

set -euo pipefail

git_bin="${GIT_BIN:-git}"

if (($# != 1)); then
    echo "remove-worktree-safely: expected exactly one argument (the worktree path)." >&2
    exit 2
fi

target="$1"

if ! command -v "$git_bin" >/dev/null 2>&1; then
    echo "remove-worktree-safely: git is not on PATH (set GIT_BIN to override)." >&2
    exit 1
fi

# The main worktree is always the first entry of `git worktree list`; use it to
# refuse deleting the main checkout. sed (not awk $2) so paths with spaces survive.
main_repo="$("$git_bin" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -1)"

if [[ -z "$main_repo" ]]; then
    echo "remove-worktree-safely: not inside a git repository." >&2
    exit 1
fi

main_repo="$(cd "$main_repo" && pwd -P)"

# The shared (common) git dir: worktree admin dirs live at
# <common>/worktrees/<name>, and each worktree's .git file points there. Used to
# recognise a deregistered orphan of THIS repo regardless of where it sits.
common_git_dir=""
if common_raw="$(cd "$main_repo" && "$git_bin" rev-parse --git-common-dir 2>/dev/null)"; then
    [[ "$common_raw" != /* ]] && common_raw="$main_repo/$common_raw"
    common_git_dir="$(cd "$common_raw" 2>/dev/null && pwd -P || true)"
fi

# Canonicalize the target. It may already be gone (idempotent re-run), so fall
# back to canonicalizing the parent and re-appending the basename.
if [[ -d "$target" ]]; then
    canonical="$(cd "$target" && pwd -P)"
else
    parent="$(dirname "$target")"
    if [[ -d "$parent" ]]; then
        canonical="$(cd "$parent" && pwd -P)/$(basename "$target")"
    else
        canonical="$target"
    fi
fi

# Never the main checkout.
if [[ "$canonical" == "$main_repo" ]]; then
    echo "remove-worktree-safely: refused — '$canonical' is the main checkout." >&2
    exit 1
fi

# Is this a worktree git currently tracks?
registered=false
if "$git_bin" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $canonical"; then
    registered=true
fi

# Does it carry a .git gitlink into THIS repo's worktrees admin area? True for a
# deregistered orphan that still has its gitlink — the leak case.
gitlinked=false
if [[ -f "$canonical/.git" && -n "$common_git_dir" ]]; then
    link_line="$(head -n1 "$canonical/.git" 2>/dev/null || true)"
    if [[ "$link_line" == "gitdir: "* ]]; then
        link_dir="${link_line#gitdir: }"
        [[ "$link_dir" != /* ]] && link_dir="$canonical/$link_dir"
        if [[ "$link_dir" == "$common_git_dir/worktrees/"* ]]; then
            gitlinked=true
        fi
    fi
fi

# Already gone and not registered → nothing to do (idempotent).
if [[ ! -e "$canonical" && "$registered" == false ]]; then
    exit 0
fi

# Safety gate: only proceed for something git recognises as a worktree of this
# repo. Computed now, before removal, so the rm -rf fallback stays authorised
# even after git deregisters the path mid-race.
if [[ "$registered" == false && "$gitlinked" == false ]]; then
    echo "remove-worktree-safely: refused — '$canonical' is not a git worktree of this repository." >&2
    exit 1
fi

# git worktree remove --force, retried a few times. Retry only the transient
# ENOTEMPTY race; bail straight to the fallback on any other error (e.g. "is not
# a working tree" for an orphan).
removed=false
attempt=0

while ((attempt < 3)); do
    attempt=$((attempt + 1))

    if err="$("$git_bin" worktree remove --force "$canonical" 2>&1)"; then
        removed=true
        break
    fi

    if [[ "$err" == *"Directory not empty"* || "$err" == *"ENOTEMPTY"* ]]; then
        echo "remove-worktree-safely: removal raced a writer (attempt ${attempt}/3), retrying…" >&2
        sleep 0.5
        continue
    fi

    break
done

# Fallback. Guarantees no orphan and reconciles git metadata regardless of which
# partial state we landed in. The safety gate above bounds this rm -rf to a
# confirmed worktree of this repo.
if [[ "$removed" == false ]]; then
    if [[ -e "$canonical" ]]; then
        rm -rf "$canonical"
    fi
    "$git_bin" worktree prune
fi

exit 0
