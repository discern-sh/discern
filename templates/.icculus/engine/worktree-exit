#!/usr/bin/env bash
# desc: graduate this worktree's branch into the main repo (tear down + check out)
. "$(dirname "$0")/lib/bootstrap.sh"

# worktree-exit (graduate) — migrate the current worktree's branch into the main
# repository so the user can review and continue work there. This is the generic
# form of the donor's graduate-worktree, invoked via `agent worktree:exit`.
#
# It hardens worktree graduation in three ways:
#   - It first requires the latest main is integrated (assert-main-merged), so a
#     branch is never graduated while stale; if main advanced it stops here.
#   - It tears down the worktree's external resources (DB + dev-server) via the
#     configured adapter seams, so graduation stops orphaning them.
#   - It removes the worktree via remove-worktree-safely (retry + rm -rf
#     fallback), so a failed removal never leaves a multi-hundred-MB orphan.
#
# Uncommitted worktree changes are WIP-committed then soft-reset after the move,
# so they land staged (not committed) in main; every *real* commit already made
# survives as a commit.
#
# Run from inside the worktree you want to graduate. No arguments.
#
# Exit codes:
#   0  - graduation succeeded
#   1  - unrecoverable error (see stderr); the branch keeps your commits

set -euo pipefail

# main_repo_path / wt_teardown live in the shared worktree helpers.
# shellcheck source=lib/worktree.sh
. "$ICCULUS_LIB/worktree.sh"

git_bin="${GIT_BIN:-git}"

# --- usage ----------------------------------------------------------------

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'USAGE'
worktree-exit (graduate)

Migrate the current git worktree's branch into the main repository:
  - Requires the latest main is already integrated (stops otherwise; you commit,
    git merge main, re-run the gate, then retry).
  - Tears down the worktree's database and dev-server link via the configured
    adapter seams.
  - Commits any uncommitted changes as WIP, then unstages that commit after the
    move so the changes land staged in the main repo.
  - Refuses to run if the main repo has uncommitted changes, so your own
    main-repo work is never moved for you — commit or stash it first, then re-run.
  - Removes the worktree directory and checks the branch out in the main repo.

Run from inside the worktree you want to graduate. No arguments.
USAGE
    exit 0
fi

# --- step 1: diagnose -----------------------------------------------------

"$git_bin" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "Not inside a git repository."

GIT_DIR=$("$git_bin" rev-parse --absolute-git-dir)
GIT_COMMON_DIR=$(cd "$("$git_bin" rev-parse --git-common-dir)" && pwd)

if [ "$GIT_DIR" = "$GIT_COMMON_DIR" ]; then
    die "This is the main repo, not a worktree — nothing to graduate."
fi

WORKTREE_PATH=$("$git_bin" rev-parse --show-toplevel)

"$ICCULUS_ENGINE/ensure-worktree-branch"

WORKTREE_BRANCH=$("$git_bin" branch --show-current)

if [ -z "$WORKTREE_BRANCH" ]; then
    die "Worktree is in detached HEAD state and ensure-worktree-branch could not create a named branch."
fi

MAIN_REPO_PATH=$(main_repo_path) \
    || die "Could not determine main repo path from 'git worktree list'."
[ "$MAIN_REPO_PATH" != "$WORKTREE_PATH" ] \
    || die "Current worktree appears to be the main worktree — refusing to proceed."
[ -d "$MAIN_REPO_PATH" ] \
    || die "Main repo path does not exist on disk: $MAIN_REPO_PATH"

# --- step 2: require main is integrated -----------------------------------

# Refuse to graduate a stale branch. assert-main-merged is a check, not a merge
# (the merge happens during `agent finish`); if main has advanced it exits
# non-zero and we stop here. By graduation time finish has normally run, so this
# is a safety net that passes.
info "Checking the branch contains the latest main…"
if ! "$ICCULUS_ENGINE/assert-main-merged"; then
    die "Branch is behind main. Run 'agent finish' to integrate it (commit, git merge main, re-run), then retry."
fi
ok "Branch contains the latest main."

# --- capture worktree state -----------------------------------------------

WORKTREE_HAS_UNCOMMITTED="false"
if [ -n "$("$git_bin" status --porcelain)" ]; then
    WORKTREE_HAS_UNCOMMITTED="true"
fi

# Sampled for the plan output so the user can ctrl-C if something important was
# parked in a gitignored path. `--directory` collapses ignored dirs.
WORKTREE_IGNORED_SAMPLE=$("$git_bin" ls-files --others --ignored --exclude-standard --directory 2>/dev/null | head -6 || true)

MAIN_HAS_UNCOMMITTED="false"
if [ -n "$("$git_bin" -C "$MAIN_REPO_PATH" status --porcelain)" ]; then
    MAIN_HAS_UNCOMMITTED="true"
fi
MAIN_BRANCH=$("$git_bin" -C "$MAIN_REPO_PATH" branch --show-current)
[ -n "$MAIN_BRANCH" ] || MAIN_BRANCH="(detached)"

# --- gate: refuse to touch a dirty main checkout --------------------------

# Checking the graduated branch out in the main repo means clearing its working
# tree first. Rather than silently stash the user's own pre-existing main-repo
# changes — a stash they didn't ask for and easily lose track of — stop now,
# before any side effects, and let them handle it. The worktree branch is
# untouched, so re-running after they commit or stash is safe.
if [ "$MAIN_HAS_UNCOMMITTED" = "true" ]; then
    die "Main checkout at $MAIN_REPO_PATH has uncommitted changes on '${MAIN_BRANCH}'.
    Commit or stash them yourself, then re-run — graduation will not move your main-repo work for you.
    Your worktree branch '${WORKTREE_BRANCH}' is untouched and still holds all its commits."
fi

# --- step 3: print plan ---------------------------------------------------

printf "\n%sGraduation plan%s\n" "$C_BOLD" "$C_RESET"
printf "  %sBranch:%s        %s\n"        "$C_DIM" "$C_RESET" "$WORKTREE_BRANCH"
printf "  %sFrom worktree:%s %s\n"        "$C_DIM" "$C_RESET" "$WORKTREE_PATH"
printf "  %sInto main:%s     %s (on %s)\n" "$C_DIM" "$C_RESET" "$MAIN_REPO_PATH" "$MAIN_BRANCH"
if [ "$WORKTREE_HAS_UNCOMMITTED" = "true" ]; then
    printf "  %sNote:%s          worktree has uncommitted changes — will WIP-commit then unstage after migration\n" "$C_DIM" "$C_RESET"
fi
if [ -n "$WORKTREE_IGNORED_SAMPLE" ]; then
    printf "  %sNote:%s          gitignored files in the worktree will be removed:\n" "$C_DIM" "$C_RESET"
    while IFS= read -r entry; do
        [ -n "$entry" ] && printf "                   %s%s%s\n" "$C_DIM" "$entry" "$C_RESET"
    done <<< "$WORKTREE_IGNORED_SAMPLE"
fi
printf "\n"

# --- step 4: tear down the worktree's external resources ------------------

# Run while still inside the worktree, so the adapter commands resolve THIS
# worktree's identity (db name, site). Non-fatal by design (see wt_teardown): a
# teardown hiccup must not strand the worktree — a later prune sweep is the
# backstop. Unlinking the dev server here also stops a live server racing the
# directory removal in step 6.
info "Tearing down the worktree's database and dev-server link…"
wt_teardown

# --- step 5: WIP commit in worktree if needed -----------------------------

MADE_WIP_COMMIT="false"
if [ "$WORKTREE_HAS_UNCOMMITTED" = "true" ]; then
    info "Committing leftover uncommitted worktree changes as WIP…"
    "$git_bin" add -A
    "$git_bin" commit --quiet -m "WIP: graduate worktree (uncommitted changes)"
    MADE_WIP_COMMIT="true"
    ok "WIP commit created."
fi

# --- step 6: switch to main repo, remove worktree -------------------------

# Main is guaranteed clean here — the dirty-checkout gate above aborts otherwise
# — so the branch checks out without disturbing any of the user's own work.
info "Switching to main repo: $MAIN_REPO_PATH"
cd "$MAIN_REPO_PATH"

info "Removing worktree: $WORKTREE_PATH"
if ! "$ICCULUS_ENGINE/remove-worktree-safely" "$WORKTREE_PATH"; then
    die "Worktree removal failed for $WORKTREE_PATH. The branch ${WORKTREE_BRANCH} holds your commits; run 'git worktree list' to investigate."
fi
ok "Worktree directory removed."

# --- step 7: check out the branch in main ---------------------------------

info "Checking out $WORKTREE_BRANCH in main repo…"
if ! checkout_err=$("$git_bin" checkout --quiet "$WORKTREE_BRANCH" 2>&1); then
    die "git checkout $WORKTREE_BRANCH failed. The branch may still be claimed elsewhere. Git said:
    $checkout_err"
fi
ok "On $WORKTREE_BRANCH at $MAIN_REPO_PATH."

# --- step 8: soft-reset the WIP commit if we made one ---------------------

if [ "$MADE_WIP_COMMIT" = "true" ]; then
    info "Unstaging WIP commit so changes land staged-but-uncommitted…"
    "$git_bin" reset --soft HEAD~1
    ok "WIP commit unstaged; previously uncommitted changes are now staged here."
fi

# --- step 9: summary ------------------------------------------------------

printf "\n%s%sGraduation complete.%s\n" "$C_BOLD" "$C_GREEN" "$C_RESET"
printf "  You are on %s%s%s in %s%s%s.\n" \
    "$C_BOLD" "$WORKTREE_BRANCH" "$C_RESET" "$C_BOLD" "$MAIN_REPO_PATH" "$C_RESET"
printf "  %sIf your shell is still in the removed worktree, run: cd %s%s\n" "$C_DIM" "$MAIN_REPO_PATH" "$C_RESET"
if [ "$MADE_WIP_COMMIT" = "true" ]; then
    printf "  Previously uncommitted worktree changes are staged — ready to commit or edit.\n"
fi
printf "\n"
