# .icculus/config.toml — the one file that teaches a stack-neutral harness about YOUR
# project. The engine under .icculus/engine/ is generic; everything specific to
# your language and tools lives here. Edit this by hand; re-run `icculus
# upgrade` to refresh the engine without touching this file.
#
# Generated by icculus {{kit_version}} for "{{project_name}}".

[project]
# Short, lowercase, dash-separated identity. Used for worktree/site/branch names.
slug = "{{project_slug}}"

# Branch prefix for worktrees created by the harness, e.g. "agent/my-feature".
branch_prefix = "{{branch_prefix}}"

# The integration branch the gate merges into and worktrees graduate onto.
# Override per-invocation with the MAIN_BRANCH env var.
main_branch = "main"

# Which agent instruction files `agent guidelines` compiles from .icculus/guidelines/.
# Known targets: "claude_code" -> CLAUDE.md, "codex" -> AGENTS.md.
agents = [{{agents_array}}]

# Where the gate points an agent when a stage fails in a non-obvious way. Keep
# this doc current with the traps specific to your stack (see the comment block
# the gate prints on failure). Empty disables the pointer.
gotchas_doc = "{{gotchas_doc}}"


# ─────────────────────────────────────────────────────────────────────────────
# [capabilities] — the core commands the gate runs, one per known capability.
# Each maps to a gate stage automatically:
#   format     fix    a formatter/codemod (mutating; runs first, serially)
#   build      build  produce artifacts later stages read (compile, bundle)
#   lint       check  read-only static analysis
#   typecheck  check  read-only type checking
#   test       test   the test suite
# A value is one command, or a list run in order: lint = ["eslint .", "stylelint ."].
# OMIT a capability you don't have — an absent capability is "knowably absent", so
# a fresh install is a green gate you grow into. Run `/bootstrap` to have your
# coding agent fill these by sniffing the repo; `agent doctor` shows which are wired.
#
# `agent tidy` is the fast inner loop: it runs the fix-stage then the check-stage
# capabilities, and never builds or tests.
# ─────────────────────────────────────────────────────────────────────────────

[capabilities]
# format    = "prettier --write ."   # or "ruff format ." or "gofmt -w ."
# build     = "npm run build"        # or "cargo build"
# lint      = "eslint ."             # or "ruff check ." or "golangci-lint run"
# typecheck = "tsc --noEmit"         # or "mypy ."
# test      = "npm test"             # or "pytest" or "go test ./..."


# ─────────────────────────────────────────────────────────────────────────────
# [checks.<name>] — custom, non-standard gate work that isn't a known capability.
# `stage` (REQUIRED) is one of fix|build|check|test; `run` the command (or a
# list); `provides` an optional free-text label. Use this for anything outside
# the five capabilities above.
# ─────────────────────────────────────────────────────────────────────────────

# [checks.licenses]
# stage    = "check"
# run      = "./scripts/check-licenses.sh"
# provides = "license-audit"


# ─────────────────────────────────────────────────────────────────────────────
# [scopes.<name>] — named regions of the repo. `paths` globs define a scope; the
# optional flags tune the gate for changes there. Classification fails OPEN: a
# path matching no scope counts as a real code change, so an unknown path runs
# MORE gates, never fewer. Globs use ** for "any depth".
#   neutral     = true   changes here need no gate (docs, agent guidance)
#   previewable = true   a person could see changes here — worth a preview link
#   gate        = "..."  a command `agent finish` runs when this scope changed
#                        (a sub-component with its own self-contained gate)
# ─────────────────────────────────────────────────────────────────────────────

# Paths that need no gate at all: docs and agent-guidance sources. (Generated
# guidance outputs are refreshed by the gate itself; editing the source changes
# no behaviour.) Root-level *.md is always treated as neutral.
[scopes.docs]
paths   = [{{scopes_neutral}}]
neutral = true

# The subset of changes a person could see — worth a preview link.
# [scopes.assets]
# paths       = [{{scopes_previewable}}]
# previewable = true

# A sub-component with its own self-contained gate:
# [scopes.native]
# paths = ["native/**"]
# gate  = "make -C native check"


# ─────────────────────────────────────────────────────────────────────────────
# [worktree] — the isolated-worktree workflow. The git mechanics are generic;
# the two seams (database, dev-server) are empty by default, so a worktree round
# is a clean no-op until you wire them to your stack.
# ─────────────────────────────────────────────────────────────────────────────

[worktree]
enabled = true

# Environment values copied from the main checkout's .env into a new worktree's
# .env (secrets a fresh worktree needs but that aren't in version control).
inherit_env = []   # e.g. ["APP_KEY", "OPENAI_API_KEY"]

# Give each worktree a deterministic dev-server port (hashed from its id) so
# concurrent worktrees never collide. Read it with `agent worktree-name --port`.
port = true

# Database seam. Each worktree gets its own database so tests never clash.
# Runtime tokens use @…@ (the engine expands them per-worktree, at run time):
# @db@ is the derived database name, @project_slug@ your project slug. Leave empty
# for a project with no database. (The example below uses a Postgres template DB.)
[worktree.db]
clone = ""   # e.g. "createdb -T @project_slug@_template @db@"
drop  = ""   # e.g. "dropdb --if-exists @db@"

# Dev-server seam — link/unlink a per-worktree site (a Docker vhost, an ngrok
# tunnel, a reverse-proxy entry, …). Leave empty for none.
[worktree.dev_server]
link   = ""
unlink = ""

# Post-create setup: commands run once after a worktree is created (install
# deps, run migrations, warm caches). Run in order.
[worktree.setup]
steps = []   # e.g. ["npm ci", "npm run build"]


# ─────────────────────────────────────────────────────────────────────────────
# [ratchets] — never-loosen quality floors, enforced on demand by `agent ratchets`
# (slow, so NOT part of `agent finish`).
#
# A ratchet is a number you only ever want to improve: line coverage, a bundle-
# size budget, a lint/type-error count, a perf budget. Each [ratchets.<name>]
# table declares one:
#   metric     the metric name the run emits        (default: the ratchet name)
#   direction  "up"   value should rise; limit is a FLOOR   (e.g. coverage)
#              "down" value should fall; limit is a CEILING (e.g. a size budget)
#   limit      the floor/ceiling — compared vs main, so a floor may only rise and
#              a ceiling may only fall (you can't loosen the gate on a branch)
#   run        the command that measures it — its output emits the metric line
#              (run on demand by `agent ratchets`, never by the gate)
#
# A ratchet's `run` reports its number by printing a line:
#   ICCULUS_METRIC <name> <number>
# (the LAST such line wins). There is no built-in or special ratchet — coverage
# is just the conventional name for one. None are configured by default;
# uncomment an example to enable it.
#
# Coverage — keep line coverage at or above a rising floor:
# [ratchets.coverage]
# direction = "up"
# limit     = 80
# run       = "your-coverage-tool"   # must emit: ICCULUS_METRIC coverage <percent>
#
# Bundle size — keep an artifact under a falling ceiling:
# [ratchets.bundle]
# metric    = "bundle_bytes"
# direction = "down"
# limit     = 500000
# run       = "printf 'ICCULUS_METRIC bundle_bytes %s\\n' \"$(wc -c < dist/app.js)\""
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# [gate] — ergonomics for the parallel gate stages (and scope gates). These
# affect how `agent finish` runs its concurrent jobs.
# ─────────────────────────────────────────────────────────────────────────────

[gate]
# Stream each job's output live (line-prefixed `── <label> │ …`) instead of
# buffering it until the stage finishes. Helps when watching a slow build/test.
# Concurrent jobs interleave (but stay labelled). Off by default (grouped).
stream = false

# Cancel the in-flight sibling commands the moment one fails, instead of running
# every command to completion. ON by default — an agent-driven gate wants a fast
# abort. Set false to run every job and see all failures in one pass. Best
# effort: a command's own grandchildren may briefly linger (portable sh has no
# atomic process-tree kill).
fail_fast = true


# ─────────────────────────────────────────────────────────────────────────────
# [recipes] — your OWN agent commands. Drop an executable script carrying a
# `# desc: ...` line into the directory below and it becomes a first-class
# `agent <name>` command, listed by `agent --help` under "Project recipes". This
# directory is yours: never managed, never refreshed by `icculus upgrade`. A name
# that collides with a built-in engine recipe (finish, worktree:*, …) is ignored
# with a warning — the engine always wins, so a project file can never redefine
# the core gate. A recipe run via `agent <name>` can source the engine library
# (`. "$ICCULUS_LIB/bootstrap.sh"`) for config_get / info / ok / die / run_parallel.
# ─────────────────────────────────────────────────────────────────────────────

[recipes]
# Where your recipes live, relative to the project root. The default works with
# no config at all; point it elsewhere (e.g. "tools/") if you prefer.
dir = ".icculus/recipes"
