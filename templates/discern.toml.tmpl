#:schema https://discern.sh/schema/v1/discern-config.schema.json
# {{artifact_provenance_marker}}
#
# discern is a stack-neutral system for coding agents and their humans.
# Use discern.toml to teach discern about your project, preferences, and tooling.
#
# The quickest way to get started is to tell your coding agent:
#   "Run `discern setup` and follow the instructions.".
#
# Help is always available through the command line or MCP server:
#   - Read the documentation:   `discern docs`   | MCP: `discern_docs`
#   - Verify your installation: `discern doctor` | MCP: `discern_doctor`
#   - Show the current status:  `discern status` | MCP: `discern_status`
#   - Refresh after an update:  `discern upgrade`
#
# Generated by discern {{kit_version}} for "{{project_name}}".

[project]
  # Display name (free text), used when compiled instructions address the project.
  # Empty falls back to the slug.
  name = "{{project_name}}"

  # Short, lowercase, dash-separated identity. Used for worktree/site/branch names.
  slug = "{{project_slug}}"

  # Where the gate points an agent when a stage fails in a non-obvious way. Keep
  # this doc current with the traps specific to your stack (see the comment block
  # the gate prints on failure). Empty disables the pointer.
  gotchas_doc = "{{gotchas_doc}}"

  # Where the deferred-work ledger lives — the running TODO list agents read and
  # maintain, relative to the project root. `discern setup` seeds it here.
  todo = "discern/TODO.md"

  # discern keeps a logbook: one line of local operational history per verb run,
  # stored under .git and shared by this repository's worktrees. Metadata only:
  # timings, outcomes, and names, never code or command output, so any line is
  # safe to read aloud. It is never committed and never transmitted. Delete it
  # with terminal-confirmed `discern patterns reset`, or seal them locally with
  # `discern patterns archive` for later reports from sealed history.
  # Recommended on. History can't be recorded after the fact, and while
  # recording is off this project goes without:
  #   - the practice report (`discern patterns`) — frozen at existing history
  #   - each worktree's last action and work in flight
  #   - fleet activity times that include verb runs
  #   - configuration-change attribution and each Standard's limit history
  #   - advisory findings on `status`, the `done` Proof, and `improvement`
  #   - wait estimates when concurrent test runs queue
  #   - the in-flight check on the contained-worktree offer
  #   - observed checkpoint economics (`discern checkpoints`)
  # Set false to stop all writes; existing history stays until you delete it.
  logbook = true

  # Which agent integrations to enable. Agent file targets:
  #   "claude_code" -> CLAUDE.md   "codex" -> AGENTS.md   "gemini" -> GEMINI.md
  #   "cursor" -> AGENTS.md        "copilot" -> AGENTS.md
  agents = [{{agents_array}}]

# ─────────────────────────────────────────────────────────────────────────────
# [repository] — policy shared by every checkout of this Git repository: where
# work lands, how discern names worktree branches, and how any checkout converges
# its local runtime state after its tracked tree changes.
# ─────────────────────────────────────────────────────────────────────────────

[repository]
  # The shared branch the gate merges into and completed work lands on. Detected
  # at setup (origin/HEAD, then the branch setup started from, then
  # init.defaultBranch). Override per-invocation with DISCERN_TRUNK.
  trunk = "main"

  # Branch prefix for worktrees created by discern, e.g. "agent/my-feature".
  branch_prefix = "{{branch_prefix}}"

  # Landed proofs are recorded as local Git notes by default. Set this to
  # "fetch" so ordinary fetches can carry them, even before a remote publishes its
  # first proof note. Publishing remains an explicit
  # `git push <remote> refs/notes/discern`.
  proof_notes = "local"

  # Idempotent commands that make ANY checkout usable for its current tracked tree
  # — typically dependency installation from a lockfile. They run in order on each
  # managed worktree pass and after `discern accept` updates the trunk checkout.
  # Post-landing failures are recorded, but later commands still run, as acceptance
  # is a one-way process. Keep worktree-identity-dependent commands under
  # [worktree.setup].ensure instead; those never run in the main checkout.
  ensure = []


# ─────────────────────────────────────────────────────────────────────────────
# [map] — the project map: discern's agent-maintained documentation tree. This is
# distinct from human-curated project docs: setup scaffolds it here, `discern map`
# browses it. Live `${<config-key>}` references keep checks, scopes, generated
# paths, and standards tied to configured entries in the source-path registry.
# ─────────────────────────────────────────────────────────────────────────────

[map]
  # Project-relative, and kept inside the repository.
  dir = "{{map_dir}}"


# ─────────────────────────────────────────────────────────────────────────────
# [instructions] — the author-once → compile-everywhere agent-instruction pipeline.
# `discern refresh` compiles discern's built-in instructions (always
# prepended) plus YOUR sources below into one generated file per
# provider. The generated files are committed so every agent — cloud
# included — reads them, but never hand-edited: edit your sources below and
# re-run `discern refresh`; `discern status` / `discern done` flag a generated
# file that has drifted from its source.
# ─────────────────────────────────────────────────────────────────────────────

[instructions]
  # Your instruction source file(s), relative to the project root. Globs are allowed
  # (the agent files themselves are never picked up as sources).
  # Read only if present; discern's built-in instructions are always prepended, so
  # these are additive. `discern setup` lays a starter source here (and migrates
  # any pre-existing CLAUDE.md/AGENTS.md into it) for your coding agent to fill.
  sources = ["discern/instructions.md"]


# ─────────────────────────────────────────────────────────────────────────────
# [skills] — focused, reusable task playbooks. The effective set is discern's
# bundled built-ins plus YOUR authored skills under the directory below, where
# yours override a built-in of the same name. discern materializes the set into
# each agent's skills dir (gitignored): built-ins copied, yours symlinked (edits live).
#   discern skills list           show the set + which of yours override which
#   discern skills eject <name>   copy a built-in here so you can customize it
# ─────────────────────────────────────────────────────────────────────────────

[skills]
  # Where your authored skills live, relative to the project root. The default
  # works with no config at all; point it elsewhere if you prefer. Read only if
  # present, so a project with no authored-skills dir uses the built-ins.
  dir = "discern/skills"

# Skill names (bundled or authored) to leave out of materialization. Every
# materialized skill occupies context in each agent session, so exclude the ones
# this project never needs. An unknown name is warned about, never fatal.
# exclude = ["a-skill-this-project-never-needs"]


# ─────────────────────────────────────────────────────────────────────────────
# [jobs] — every command the gate runs, in one namespace. Known names derive
# their gate stage automatically:
#   format     fix    a formatter/codemod (mutating; runs first, serially)
#   build      build  produce artifacts later stages read (compile, bundle)
#   lint       check  read-only static analysis
#   typecheck  check  read-only type checking
#   test       test   the test suite
#   smoke      test   a fast, side-effect-light readiness check: the app boots
#                     and its essential shared runtime needs work in this checkout
# A value is one command, or a list run in order: lint = ["eslint .", "stylelint ."].
# A job needing its own time budget takes the table form — the `timeout` (seconds)
# replaces the global [gate].timeout for that job only, 0 disables its bound:
#   test = { run = "npm test", timeout = 1200 }
# OMIT an individual known job you truly do not have yet. A config with no known
# jobs wired is only a bootstrap state: the gate can pass without its built-in
# protections, so `discern doctor` reports it as a warning. `discern setup` has
# your coding agent fill these by sniffing the repo; `discern doctor` shows which
# known names and custom jobs are wired.
#
# `discern prepare` is the fast inner loop: it runs the fix-stage jobs, regenerates
# every `[generated]` group, then runs the check-stage jobs — never build jobs or tests.
#
# `smoke` is the project's fast readiness check — real config and essential shared
# runtime dependencies that Discern cannot infer. Keep it much faster than `test`:
# `discern done` and `discern test` run it in the same fail-fast test group, so a
# quick smoke failure cancels slower siblings.
# Custom names use `[jobs.<name>]` and MUST declare `stage` (fix|build|check|test)
# plus `run` (a command or list). `provides` is an optional free-text label;
# `timeout` has the same per-job meaning as above. Known names MUST NOT declare
# `stage`: their stage comes from the list above.
# Commands, scope paths and gates, generated paths and runs, checkpoint paths,
# and Standard `run`/`inputs`/`per` globs accept `${<config-key>}` references
# for every configured source in the paths registry, plus the configured
# gotchas doc (`${project.gotchas_doc}`). Unregistered braced forms stay
# untouched, so ordinary shell expansion keeps working.
# ─────────────────────────────────────────────────────────────────────────────

[jobs]
  # Keep `discern tidy` last: it formats the map, instructions, TODO, and this file.
  # Add the project's own formatter before it when one exists, for example:
  # format    = ["prettier --write .", "discern tidy"]
  format = "discern tidy"
  # build     = "npm run build"        # or "cargo build"
  # lint      = "eslint ."             # or "ruff check ." or "golangci-lint run"
  # typecheck = "tsc --noEmit"         # or "mypy ."
  # test      = "npm test"             # or "pytest" or "go test ./..."
  # smoke     = "your-app --version"   # fast boot/readiness — a CLI --version,
  #                                    # framework about, or real-config load-and-exit


  # [jobs.licenses]
  # stage    = "check"
  # run      = "./scripts/check-licenses.sh"
  # provides = "license-audit"


  # ─────────────────────────────────────────────────────────────────────────────
  # [scopes.<name>] — named regions of the repo. `paths` globs define a scope; the
  # optional flags tune the gate for changes there. Classification fails OPEN: a
  # path matching no scope counts as a real code change, so an unknown path runs
  # MORE gates, never fewer. Globs use ** for "any depth" — a directory prefix
  # ("src/**"), a standard glob ("src/**/*.ext", "src/*"), a "*.ext" suffix at
  # any depth, a "/seg/" segment, or an exact path.
  #   neutral     = true   changes here need no gate (docs, agent instructions)
  #   previewable = true   a person could see changes here — worth a preview link
  #   gate        = "..."  a command `discern done` runs when this scope changed
  #                        (a sub-component with its own self-contained gate)
  #   timeout     = N      seconds; replaces the global [gate].timeout for this
  #                        scope's gate job only (0 disables its bound)
  # ─────────────────────────────────────────────────────────────────────────────

  # Pure documentation: the map and the deferred-work ledger. Needs no gate, and
  # the [acceptance] example below grants this scope alone. Root-level *.md is
  # always treated as neutral.
  [scopes.map]
    paths   = [{{scopes_neutral}}]
    neutral = true

  # Agent-instruction surfaces: the project brief, authored instructions and skills,
  # and the exact materialized-skills directories compiled from them. Gate-neutral
  # like the map scope, but outside the [acceptance] example: these files steer
  # agents, so landing them stays owner-reviewed. Executable Project Scripts and
  # provider-owned sibling files still run the gate.
  [scopes.instructions]
    paths   = [{{scopes_instructions}}]
    neutral = true

# The subset of changes a person could see — worth a preview link.
# [scopes.assets]
# paths       = [{{scopes_previewable}}]
# previewable = true

# A sub-component with its own self-contained gate:
# [scopes.native]
# paths = ["native/**"]
# gate  = "make -C native check"


# ─────────────────────────────────────────────────────────────────────────────
# [generated.<name>] — committed artifacts wholly owned by one generator.
#   paths    scope-style globs naming every artifact the generator owns
#   run      the command, or commands in order, that rewrite those artifacts;
#            the same tree must produce the same bytes, and the generator removes
#            artifacts absent from its current output
#   linguist_generated
#            optional; true marks only this group's paths as generated for GitHub,
#            hiding them in diffs by default and excluding them from language stats
#   timeout  optional seconds for the command; replaces [gate].timeout for this
#            group only (0 disables the bound)
# ─────────────────────────────────────────────────────────────────────────────

[generated]
# A tool that writes a committed reference from source:
# [generated.reference]
# paths   = ["reference/**"]
# run     = "tool write-reference --source source/ --output reference/"
# linguist_generated = false
# timeout = 120


# ─────────────────────────────────────────────────────────────────────────────
# [acceptance] — standing grants for landing. Each entry names a scope whose
# changes may land without a per-landing conversation. The owner records this
# decision on the trunk. Scope definitions become consent-bearing: widening a
# named scope widens its grant. An empty list changes nothing; landing asks for
# the owner's acceptance as it does today. The example grants pure documentation
# only; agent-instruction surfaces stay owner-reviewed.
# ─────────────────────────────────────────────────────────────────────────────

[acceptance]
  pre_authorized = [] # e.g. ["map"]


# ─────────────────────────────────────────────────────────────────────────────
# [worktree] — the isolated-worktree workflow. The git mechanics are generic;
# everything project-specific is a RESOURCE you declare below. A fresh install
# declares none, so a worktree round is a clean no-op until you wire one.
# ─────────────────────────────────────────────────────────────────────────────

[worktree]
  # Where per-worktree checkouts are created (a <name> dir is made under it).
  #   ""  (the default) a SIBLING of the repo, "<repo>.worktrees/<name>" — visible
  #       and adjacent, never nested inside the checkout (a worktree nested in its
  #       own repo is an anti-pattern: recursive tools double-count it, and walking
  #       up to the repo root mis-resolves the worktree's .git file).
  #   a RELATIVE path resolves against the repo root (".claude/worktrees" nests
  #       them inside the repo; "../wts" a custom sibling).
  #   an ABSOLUTE path is used as-is.
  root = ""

  # Environment values copied from the main checkout's env files into a new
  # worktree's (secrets a fresh worktree needs but that aren't in version
  # control). The worktree's env file is created when absent, so a declared
  # value always arrives.
  inherit_env = []   # e.g. ["APP_KEY", "OPENAI_API_KEY"]

  # The env files the worktree lifecycle reads and writes, in precedence order:
  # when reading, the last listed file that defines a value wins (the dotenv
  # override convention); a newly written value lands in the first. inherit_env
  # reads these in the main checkout and writes the worktree's copy; the
  # deterministic port and resource handles are recorded into them too.
  env_files = [".env", ".env.local"]

  # Record a deterministic dev-server port (hashed from the worktree id) in the
  # worktree's env file. Enable this when the project's dev tooling reads
  # DISCERN_WORKTREE_PORT. The port remains available through
  # `discern identity --port` while this is false.
  port = false

  # Track ignored files at worktree setup and report top-level ignored paths that
  # changed before the worktree is removed. Turn this off for projects whose
  # ignored outputs churn too much to be useful.
  ignored_file_drift = true

  # ─────────────────────────────────────────────────────────────────────────────
  # [worktree.resources.<name>] — per-worktree external resources (a database, an
  # emulator, a container, a queue). Each declares a `create` command (run once at
  # setup) and a `destroy` (run once at teardown), with optional `ensure`
  # (re-readiness at session start), `required` (default true: a create failure
  # aborts setup), `retries` (default 0), and `gc` (default true: may orphan-prune
  # reclaim it). Resources are CREATED top-to-bottom and DESTROYED bottom-to-top.
  # Commands run via `sh -c` after @…@ token expansion; an empty command is a clean
  # no-op. A worktree that vanishes without a clean teardown has its resources
  # reclaimed by `discern worktree prune` (the GC safety net) — so author `create` AND
  # `destroy` idempotent (`create` is skipped for an already-provisioned resource;
  # `destroy` may re-run via prune) and cwd-independent (prune runs `destroy` from the
  # main checkout: use @…@ handles or absolute paths, not relative ones).
  #
  # Runtime tokens (expanded per-worktree, at run time):
  #   @worktree@      this worktree's base handle   (slug-id)
  #   @resource@      this resource's handle        (slug-id-name; this resource only)
  #   @db@            database-name-safe identity    (underscores; for db engines)
  #   @site@          dev-server site/host name      (DNS-safe; for vhosts/tunnels)
  #   @port@          the deterministic dev-server port
  #   @project_slug@  your project slug
  #   @dir@           this worktree's root
  # Read a handle back from a project script with `discern identity --resource <name>`
  # (also exported into the worktree's .env as DISCERN_RESOURCE_<NAME>).
  # ─────────────────────────────────────────────────────────────────────────────

  # A per-worktree database, so tests never clash. Uses @db@ (db-name-safe).
  # [worktree.resources.db]
  # create  = "createdb -T @project_slug@_template @db@"
  # destroy = "dropdb --if-exists @db@"

  # A per-worktree dev-server site (a Docker vhost, an ngrok tunnel, a reverse-proxy
  # entry, …). Uses @site@ (DNS-safe). Declared after db so it is torn down first.
  # [worktree.resources.dev_server]
  # create  = "link-site @site@ @port@"
  # destroy = "unlink-site @site@"

  # Any other isolated resource — an emulator, a queue, a bucket, a namespace.
  # [worktree.resources.example]
  # create   = "make-thing @resource@"
  # destroy  = "destroy-thing @resource@"   # idempotent: may re-run via worktree prune
  # ensure   = "ensure-thing @resource@"   # optional: reconcile drift at session start
  # required = true                          # optional: false = create failure is non-fatal
  # retries  = 0                             # optional: retry create/destroy N times
  # gc       = true                          # optional: false = never orphan-prune it
  #                                          #   (teardown-only; for data-loss-sensitive ones)

  # Worktree setup commands, run after the resources are provisioned — two buckets,
  # the same split as a resource's create/ensure:
  #   steps   one-shot scaffolding, run ONCE at creation and not re-run (skipped once
  #           the worktree is configured): seed fixtures, generate a local-only file.
  #   ensure  LINKED-WORKTREE convergence, re-run on EVERY pass — at creation, on
  #           session-start re-entry, and after `discern update` brings the trunk in.
  #           Use it for commands that depend on worktree identity, ports, or
  #           resources. Put checkout-generic dependency installs and builds in
  #           [repository].ensure so acceptance also converges the trunk checkout.
  #           Author each command idempotent: it re-runs routinely.
  # Both run in order via `sh -c`. A failed `ensure` aborts setup at creation; on a
  # re-entry or update it is recorded but never undoes a merge or blocks startup.
  [worktree.setup]
    steps = []   # one-shot, e.g. ["seed-fixtures"]
    ensure = []  # linked-worktree-only, e.g. ["<ready worktree resource>"]


  # ─────────────────────────────────────────────────────────────────────────────
  # [standards] — quality standards: numbers that can never get worse. Every
  # `discern done` run verifies no limit loosened versus the trunk (always — that
  # check has no off switch) and measures each standard in parallel with the
  # tests, so a branch can neither quietly loosen a limit nor quietly regress a
  # metric. None configured means none run — defining one is what turns the
  # subsystem on.
  #
  # Each limit may only improve: line coverage, a bundle-size budget, a lint/type-
  # error count, a perf budget. Sort the number before holding it: an invariant a
  # healthy project never adds (suppressions, a banned pattern) holds the raw
  # count; a quality that scales (coverage, alert density) holds a rate via
  # `per`; a total that grows with the product (a size, a word count) needs
  # `margin` and an owner willing to raise the limit as the product grows —
  # pinned at today's value it fails the next legitimate change.
  #
  # Each [standards.<name>] table declares one:
  #   metric     the metric name the run emits        (default: the standard name)
  #   direction  required:
  #              "up"   value should rise; limit is a FLOOR   (e.g. coverage)
  #              "down" value should fall; limit is a CEILING (e.g. a size budget)
  #   limit      the floor/ceiling — compared vs main, so a floor may only rise and
  #              a ceiling may only fall (you can't loosen the gate on a branch)
  #   run        the command that measures it — its output emits the metric line
  #              (run by the gate alongside the tests, and by `discern standards`)
  #   per        divide the metric to hold a RATE, not a raw count — so the number
  #              doesn't rise just because the project grew. Either a second metric the
  #              run emits, or a built-in extent discern measures itself:
  #              per = { words = "${map.dir}**" }  (files | lines | words | bytes over a pathspec)
  #   scale      multiply the rate so the limit reads in human units (e.g. 1000)
  #   margin     headroom `discern standards --pin` leaves when it tightens this limit
  #              to the measured value (default 0). Give a metric that drifts on
  #              unrelated commits (a size, a coverage %) a margin so a pinned limit
  #              isn't tripped by ordinary fluctuation.
  #   inputs     the paths the metric reads (scope-style globs). When nothing under
  #              them changed since the last recorded measurement, the gate replays
  #              that value instead of re-measuring — a docs-only change pays
  #              seconds, not a coverage run. Honest risk: too-narrow inputs delay
  #              detection until the next measured run. Omit to always measure.
  #   timeout    seconds; replaces the global [gate].timeout for this measurement
  #              job only (0 disables its bound)
  #   measure    "gate" (default) measures in every `discern done`; "on-demand"
  #              defers a metric genuinely too slow for every gate run to
  #              `discern standards` — the never-loosen limit check still runs on
  #              every gate. Reach for the smaller reliefs first: declare `inputs`
  #              so unchanged trees replay for free, or raise this job's `timeout`.
  #
  # A standard's `run` reports its number by printing a line:
  #   DISCERN_METRIC <name> <number>
  # (the LAST such line wins). There is no built-in or special standard — coverage
  # is just the conventional name for one. None are configured by default;
  # uncomment an example to enable it.
  #
  # Captured a gain? `discern standards --pin` tightens each improved limit to the
  # value just measured and commits it — the way to tighten a standard, never a
  # hand-edit (which can't tell a real gain from a quiet loosening).
  # ─────────────────────────────────────────────────────────────────────────────

  # Coverage — keep line coverage at or above a rising floor:
  # [standards.coverage]
  # direction = "up"
  # limit     = 80
  # run       = "your-coverage-tool"   # must emit: DISCERN_METRIC coverage <percent>
  #
  # Bundle size — a raw count is right here: shipped bytes are a true budget, they
  # don't grow just because the repo does. Keep the artifact under a falling ceiling:
  # [standards.bundle]
  # metric    = "bundle_bytes"
  # direction = "down"
  # limit     = 500000
  # run       = "printf 'DISCERN_METRIC bundle_bytes %s\\n' \"$(wc -c < dist/app.js)\""
  #
  # Lint density — a RATE, for a count that WOULD grow with the project. Divide by a
  # built-in extent so adding clean code never breaches it, only nittier code does:
  # [standards.lint_density]
  # metric    = "warnings"
  # direction = "down"
  # per       = { lines = "src/**" }   # discern counts the lines itself
  # scale     = 1000                   # express "warnings per 1,000 lines"
  # limit     = 5
  # run       = "your-linter --count"  # must emit: DISCERN_METRIC warnings <count>


  # ─────────────────────────────────────────────────────────────────────────────
  # [checkpoints.<name>] — change-triggered review rules. A deterministic trigger
  # decides when a diff makes a named question relevant; the agent judges the
  # question and records its conclusion, which travels with the gate's results
  # as agent judgment, kept distinct from machine results. The configuration that
  # governs an effort is the one at its merge-base with the trunk, so editing
  # these tables on a branch never changes that branch's own gate. None
  # configured means none fire.
  #
  # Each [checkpoints.<name>] table declares one:
  #   scope      selector: a configured [scopes.<name>] whose paths choose the
  #              matched set (one selector — use scope OR paths, never both)
  #   paths      selector: globs choosing the matched set (same dialect as scopes)
  #   unless_changed
  #              hold fire when any changed path matches one of these — each
  #              entry a glob, or a configured scope name ("flag this change
  #              class unless its counterpart moved too")
  #   min_changed_files
  #              fire only when at least this many matched files changed
  #   deletion_dominant
  #              fire only when removals clearly outweigh additions in the
  #              matched change (a big cut earns a look; an ordinary edit or a
  #              balanced refactor does not)
  #   similar_new_file
  #              fire only when the change adds a file whose name closely
  #              resembles an existing sibling in the same directory — the
  #              signature of a parallel implementation growing beside the
  #              original
  #   when       executable escape hatch for conditions the fields above cannot
  #              express: a command run pre-flight with a short fixed timeout.
  #              Exit 0 fires the trigger, exit 1 passes, and any other exit or
  #              a timeout fails open (no fire) with an advisory. It may print
  #              `DISCERN_MATCH <path>` lines to declare the matched paths
  #              precisely; with selectors present, they pre-scope the diff and
  #              `when` decides firing.
  #   mode       "stop" (the default): `discern done` refuses to run the gate
  #              until the agent declares the question met, or unmet with a
  #              short rationale. "advise": delivered as an advisory instead;
  #              never blocks.
  #   question  the judgment prose the agent evaluates against the matched
  #              change. Required for your own checkpoints; a table whose <name>
  #              is a shipped built-in id inherits its question.
  #   teach      optional lesson prose carried into renderings: why the
  #              question matters and what good looks like.
  # ─────────────────────────────────────────────────────────────────────────────

  # Shipped built-ins: referencing an id enables it — the trigger, mode, and
  # question come from the built-in, and any field set here overrides its
  # default (retune with min_changed_files, retarget with paths/scope, soften
  # with mode = "advise"). Delete or comment out an entry to disable it.
  # Overriding `question` replaces the shipped judgment with your own authored
  # prose.
  #
  # Four stop checkpoints guard the knowledge estate — the surfaces that steer
  # every future agent session. `discern done` pauses before the gate until the
  # agent declares each fired question met, or unmet with a rationale:
  [checkpoints.map-focus]           # a broad map change must reduce future reading
  [checkpoints.instruction-economy] # always-loaded prose pays rent in every session
  [checkpoints.skills-playbook]     # a skill is an executable playbook
  [checkpoints.gotchas-playbook]    # failure memory stays symptom → cause → recovery
  # (quiet until [project].gotchas_doc names a doc)

  # Five advisory checkpoints read the shape of the change — never blocking,
  # delivered with the gate's advisories when their pattern appears:
  [checkpoints.deletion-heavy-change]   # a substantial cut: proven dead, recoverable?
  [checkpoints.parallel-implementation] # a name-similar sibling file appeared
  [checkpoints.effort-sprawl]           # one effort, or several riding along?
  [checkpoints.docs-drift]              # code moved and the map did not
  [checkpoints.commit-story]            # a large change: do the messages tell the why?

# Stack-aware examples, inert until you name your paths: discern never guesses
# your stack, so these ship commented out with the question already written.
# Uncomment one, point its globs at your real files, and it governs new
# efforts once the change lands on the trunk.

# A new dependency is a liability the owner carries — license, supply chain,
# upkeep. Point `paths` at your manifest(s), for example:
#   package.json (JS/TS)        Cargo.toml (Rust)     go.mod (Go)
#   pyproject.toml (Python)     Gemfile (Ruby)        composer.json (PHP)
#   pom.xml, build.gradle* (JVM)                      *.csproj (.NET)
# [checkpoints.new-dependency]
# paths = ["package.json"]
# mode  = "advise"
# question = """
# This change edits a dependency manifest. For each dependency added or
# upgraded: is it worth the liability it adds — license fit, supply-chain
# exposure, maintenance horizon — against writing the small part you need?
# State what it buys.
# """

# A deleted or skipped test is a lowered guard. Point `paths` at your test
# tree(s); deletion dominance keeps ordinary test refactors quiet:
# [checkpoints.shrinking-tests]
# paths             = ["tests/**"]
# deletion_dominant = true
# mode              = "advise"
# question = """
# This change removes clearly more test than it adds. Is every removed or
# skipped case re-covered elsewhere, or is the narrowed protection deliberate?
# Say which in the commit body — a guard lowered silently is how regressions
# return.
# """

# Some regions deserve a stated risk before anything lands — authentication,
# billing, data migrations, anything where a mistake leaks or breaks. Name
# the regions the owner watches; `stop` (the default) holds `discern done`
# until the agent declares its conclusion:
# [checkpoints.sensitive-paths]
# paths = ["src/auth/**", "migrations/**"]
# question = """
# This change touches a region the owner marked sensitive. What could break
# or leak if this is wrong, what protects against that, and what should a
# reviewer look at first?
# """

# A project-authored checkpoint: when the interface changed, its contract docs
# were either updated too or consciously judged unaffected.
# [checkpoints.interface-review]
# paths          = ["src/api/**"]
# unless_changed = ["docs/api/**"]
# question      = """
# A changed interface is described in its docs before it lands: new entry points
# state their failure modes; changed contracts note what callers must revisit.
# """


# ─────────────────────────────────────────────────────────────────────────────
# [gate] — ergonomics for the parallel gate stages (and scope gates). These
# affect how `discern done` runs its concurrent jobs.
# ─────────────────────────────────────────────────────────────────────────────

[gate]
  # Controls static terminal transcripts only: false groups complete per-job output;
  # true streams prefixed lines. Live-capable terminals always show the Gate frame's
  # bounded tail. CI, pipes, --plain, and no-cursor terminals are static. Off by default.
  stream = false

  # Cancel the in-flight sibling commands the moment one fails, instead of running
  # every command to completion. ON by default — an agent-driven gate wants a fast
  # abort. Set false to run every job and see all failures in one pass. The engine
  # tree-kills a cancelled job's whole process group, so its grandchildren don't
  # linger.
  fail_fast = true

  # Per-command time budget in SECONDS, applied to every job the gate runs (each
  # declared job, scope gate, and standard measurement). A command that
  # doesn't exit within it is tree-killed and the stage fails with a plain-language
  # timeout diagnostic — so the gate can never hang. The usual culprit is a
  # watch-mode test runner or a dev server wired without its single-run form.
  # Generous by default (600 = 10 min); set 0 to disable the limit (not
  # recommended — the gate can then hang forever). One legitimately slow job takes
  # its own `timeout` on its config entry instead of a slower global.
  timeout = 600

  # Cap on how many test-stage runs may be in flight AT ONCE across every checkout
  # of this repository — the main checkout and all its linked worktrees. It counts
  # whole runs (`discern done`'s and `discern test`'s test group, and `discern
  # standards`' measurement pass); each run's own test-runner worker parallelism
  # is untouched. Parallel agents each running a machine-saturating suite slow
  # each other down more than a queue would; with a cap, a run arriving past it
  # waits for a slot before its tests start (fix and check stages never wait —
  # a broken check still fails fast), says what it is waiting for, and continues
  # the moment a slot frees. A killed run's slot is released by the operating
  # system, so a crash never blocks the others. 0 (the default) means no cap;
  # 1 runs every suite at full speed, one after another. Wrap the project's own
  # test task with `discern queue -- <command>` so direct invocations share it.
  concurrent_test_runs = 0


# ─────────────────────────────────────────────────────────────────────────────
# [coupling] — co-change detection: a read-only advisory that mines git history
# for files that change TOGETHER, so a touched file's habitual sibling isn't
# forgotten. Read it on demand with `discern coupling` (no argument → what
# co-changes with your current change set but is MISSING from it; `discern
# coupling <path>` → one file's top partners, its blast radius; `discern coupling
# <a> <b>` → the commits where both changed, to judge a coupling). It is
# ZERO-CONFIG: it self-calibrates to your repo (commit size, cadence, scale), so
# there are no thresholds to tune. As an ADVISORY, it points at where to look.
# ─────────────────────────────────────────────────────────────────────────────

[coupling]
  # Surface the advisory during the gate too — `discern done` AND the fast inner
  # loop `discern prepare` (as hints at the tail), so
  # the nudge meets a change while it is hot. On by default; set false to keep
  # coupling available only through `discern coupling`.
  in_gate = true


# ─────────────────────────────────────────────────────────────────────────────
# [scripts] — your own executable project scripts. Drop any executable into the
# directory below; `discern scripts` lists it and `discern scripts <name>` runs it.
# An optional `# desc: ...` line describes it in the listing. This directory is
# yours: `discern upgrade` never writes or refreshes anything here. Built-in names
# are legal because project scripts live under their own command namespace. A
# project script can use any language; discern exports DISCERN_* environment values
# (DISCERN_ROOT, DISCERN_SCRIPTS, DISCERN_TRUNK, …) and forwards every
# argument after its name unchanged. It reads config by calling the binary
# (`discern config get <key>`) and resolves worktree
# identity with `discern identity --db|--site|--port|--resource <name>`.
# ─────────────────────────────────────────────────────────────────────────────

[scripts]
  # Where your project scripts live, relative to the project root. The default works with
  # no config at all; point it elsewhere (e.g. "tools/") if you prefer.
  dir = "discern/scripts"


# ─────────────────────────────────────────────────────────────────────────────
# [meta] — installer bookkeeping, managed by discern. Nothing here needs your
# attention.
# ─────────────────────────────────────────────────────────────────────────────

[meta]
  # The install schema version — managed by discern (bumped by `discern upgrade`).
  # Don't edit this by hand.
  schema_version = 1
