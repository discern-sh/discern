#!/usr/bin/env sh
# desc: lint one or more map pages with the full house-voice rules, warnings included
#
# The gate blocks errors and house-style findings except rules registered
# for editorial review in scripts/prose_lib.ts. This loop shows all findings
# for the pages you are writing:
#
#   discern scripts prose-page project/map/10-getting-started/quickstart.md
#
# Resolve blocking defects and judge the editorial findings in context.
# Keep a flagged construction when it helps the reader understand or act.

set -eu

ROOT="${DISCERN_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}"
MAP_DIR=$(discern config get map.dir 2>/dev/null) || MAP_DIR="project/map/"

exec deno run --config "$ROOT/deno.json" \
  --allow-read --allow-write --allow-env --allow-run \
  "$ROOT/scripts/prose_check.ts" "$ROOT/$MAP_DIR" --min-level=suggestion "$@"
