#!/usr/bin/env sh
# desc: health-check the engine side of the install (config, git, capabilities)
. "$(dirname "$0")/lib/bootstrap.sh"

# doctor — verify the harness is wired up correctly and report ACTIONABLE
# findings (what is wrong + how to fix it), not just pass/fail. Two severities:
#
#   ERROR (fail)   a broken install: the gate cannot run correctly as-is.
#                  Exits non-zero. Examples: config has no slug, git missing, a
#                  configured command's executable is absent, an unknown
#                  capability key, a check with an invalid stage.
#   WARNING (warn) an advisory: the install runs, but something is probably not
#                  what you want. Exits 0 (it is not a broken install). Examples:
#                  not yet ready for agentic development (no test/static check),
#                  or the harness layered onto another tool that ALSO automates
#                  worktrees / owns CLAUDE.md.
#
# Checks, in order:
#   - .icculus/config.toml parses (project.slug resolves) and slug looks like a slug
#   - the capability READINESS checklist: which known capabilities
#     (format/build/lint/typecheck/test) are wired, and a "ready for agentic
#     development" verdict (test plus at least one static check)
#   - no unknown [capabilities] key (one would silently never run)
#   - every [checks.<name>] names a valid stage
#   - git is present and supports worktrees (`git worktree list`)
#   - every capability/check command's first token resolves on PATH
#   - the gotchas doc exists when [project].gotchas_doc is set
#   - every [scopes.<name>].gate command's first token resolves on PATH
#   - foreign tooling: another worktree automation in .claude/settings.json, or
#     a CLAUDE.md owned by a different guideline compiler
#
# --json emits a machine-readable report with SEPARATE errors and warnings
# arrays (plus the full findings list and an `ok` boolean).

# shellcheck source=lib/validate.sh
. "$ICCULUS_LIB/validate.sh"

as_json=0
case "${1:-}" in
    --json) as_json=1 ;;
    -h|--help) printf 'Usage: doctor [--json]\n'; exit 0 ;;
    "") ;;
    *) die "doctor: unknown argument '$1'." ;;
esac

# Findings accumulate as "level\tmessage\tfix" lines in a temp file, so we can
# render text or JSON from one pass. level is ok|warn|fail.
report=$(mktemp "${TMPDIR:-/tmp}/icculus-doctor.XXXXXX") || die "doctor: mktemp failed."
# shellcheck disable=SC2064
trap "rm -f '$report'" EXIT INT TERM
had_failure=0

# Record a finding. add <level> <message> [fix]
add() {
    printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >> "$report"
    [ "$1" = "fail" ] && had_failure=1
    return 0
}

# First whitespace-delimited token of a command string (its executable).
first_token() {
    printf '%s' "$1" | awk '{ print $1; exit }'
}

# Resolve a command's executable on PATH, recording a finding. $1 is a label
# (e.g. "capability 'lint'"), $2 the command. A few shell builtins a command may
# legitimately start with are accepted without a PATH lookup.
resolve_cmd() {
    _rc_tok=$(first_token "$2")
    case "$_rc_tok" in
        :|true|false|echo|cd|test|[) add ok "$1 runs a shell builtin ($_rc_tok)."; return 0 ;;
    esac
    if command -v "$_rc_tok" >/dev/null 2>&1; then
        add ok "$1 command resolves ($_rc_tok)."
    else
        add fail "$1 command not found: $_rc_tok" "Install $_rc_tok, or fix the command in $ICCULUS_TOML."
    fi
}

# --- config parses --------------------------------------------------------

slug=$(config_get project.slug "")
if [ -z "$slug" ]; then
    add fail ".icculus/config.toml has no project.slug." "Set [project].slug in $ICCULUS_TOML."
elif validate_is_slug "$slug"; then
    add ok ".icculus/config.toml parses (project.slug = $slug)."
else
    add fail "project.slug '$slug' is not a valid slug." "Use lowercase letters, digits and dashes, starting with a letter or digit (e.g. my-app) in $ICCULUS_TOML."
fi

# --- capability readiness --------------------------------------------------
#
# The capability checklist is the heart of doctor: which of the known capabilities
# (format/build/lint/typecheck/test) are wired, and which are knowably absent. An
# absent capability is informational — a fresh install is a green gate you grow
# into — so a ✗ is an `ok`-level note, not a failure. A capability is "wired" when
# config_array yields at least one non-empty command.

have_cap() { [ "$(config_array "capabilities.$1" | grep -c .)" -gt 0 ]; }

for cap in $ICCULUS_CAPABILITIES; do
    cap_n=$(config_array "capabilities.$cap" | grep -c .)
    if [ "$cap_n" -gt 0 ]; then
        add ok "capability '$cap' wired ($cap_n command(s), stage $(cap_stage "$cap"))."
    else
        add ok "capability '$cap' not configured (a known capability, knowably absent)."
    fi
done

# An unknown key under [capabilities] has no derivable stage, so it would silently
# never run — a HARD error pointing at the right home ([checks]).
for cap in $(config_keys capabilities); do
    cap_is_known "$cap" && continue
    add fail "[capabilities].$cap is not a known capability." "Known capabilities are: $(capability_list). For custom work use a [checks.<name>] table with an explicit stage."
done

# --- checks (the custom escape hatch) -------------------------------------
#
# A [checks.<name>] must name a valid stage — an invalid one silently drops it
# from its track (false confidence), so it is a HARD error. Warn when a check
# reuses a known capability name (their gate job labels would collide).

for chk in $(config_subsections checks); do
    chk_stage=$(config_get "checks.$chk.stage" "")
    if [ -z "$chk_stage" ]; then
        add fail "check '$chk' has no stage." "Set checks.$chk.stage to one of: $(stage_list)."
    elif ! stage_is_valid "$chk_stage"; then
        add fail "check '$chk' has an unknown stage '$chk_stage'." "Set checks.$chk.stage to one of: $(stage_list)."
    fi
    if cap_is_known "$chk"; then
        add warn "check '$chk' shares a name with the '$chk' capability — their gate labels may collide." "Rename the check, or move its command into [capabilities].$chk if it is that capability."
    fi
done

# --- readiness verdict -----------------------------------------------------
#
# The minimal bar for agentic development: a gate that runs tests AND at least one
# static check. Below it the install still works (warn, exit 0) — it just is not
# yet pulling its weight.

if have_cap test && { have_cap lint || have_cap typecheck; }; then
    add ok "Ready for agentic development: 'test' plus at least one static check are wired."
else
    add warn "Not yet ready for agentic development — wire at least 'test' plus one of lint/typecheck." "Add them to [capabilities] in $ICCULUS_TOML (or run /bootstrap to have your agent propose fills)."
fi

# --- scopes present -------------------------------------------------------
#
# Scope classification drives which gates and the preview fire. With no scopes at
# all, every change is just "code" (fine, but worth noting); a scope with empty
# `paths` can never match. Both are advisories (the gate still runs its jobs).

if ! config_subsections scopes | grep -q .; then
    add warn "No [scopes.<name>] are defined — every change is treated as gated code." "Add a neutral scope for docs (e.g. [scopes.docs] with paths = [\"docs/\"] and neutral = true) in $ICCULUS_TOML."
else
    for scope in $(config_subsections scopes); do
        scope_paths=$(config_array "scopes.$scope.paths" | grep -c .)
        [ "$scope_paths" -gt 0 ] || add warn "[scopes.$scope] has no paths — it can never match." "List globs in scopes.$scope.paths (e.g. [\"src/**\"]) in $ICCULUS_TOML."
    done
fi

# --- git + worktree support ----------------------------------------------

if command -v git >/dev/null 2>&1; then
    if git worktree list >/dev/null 2>&1; then
        add ok "git is present and supports worktrees."
    else
        add warn "git is present but \`git worktree list\` failed here." "Run doctor from inside the git repository."
    fi
else
    add fail "git is not on PATH." "Install git — the harness uses it for scope detection and the worktree workflow."
fi

# --- capability + check commands resolve -----------------------------------
#
# Every command a capability or check would run must have its first token on PATH.
# An array-valued capability is checked per element (labelled cap / cap#2). The
# inner loop reads via a here-doc (not a pipe) so resolve_cmd's `add fail` reaches
# had_failure in this shell.

for cap in $(config_keys capabilities); do
    cap_is_known "$cap" || continue   # unknown keys are flagged above
    cap_i=0
    while IFS= read -r cap_cmd; do
        [ -n "$cap_cmd" ] || continue
        [ "$cap_cmd" = ":" ] && continue
        cap_i=$((cap_i + 1))
        if [ "$cap_i" -eq 1 ]; then cap_lbl="capability '$cap'"; else cap_lbl="capability '$cap#$cap_i'"; fi
        resolve_cmd "$cap_lbl" "$cap_cmd"
    done <<EOF
$(config_array "capabilities.$cap")
EOF
done

for chk in $(config_subsections checks); do
    chk_run=$(config_get "checks.$chk.run" "")
    [ -n "$chk_run" ] || continue
    [ "$chk_run" = ":" ] && continue
    resolve_cmd "check '$chk'" "$chk_run"
done

# --- gotchas doc exists ---------------------------------------------------

gotchas_doc=$(config_get project.gotchas_doc "")
if [ -n "$gotchas_doc" ]; then
    if [ -f "$ICCULUS_ROOT/$gotchas_doc" ]; then
        add ok "gotchas doc exists ($gotchas_doc)."
    else
        add fail "gotchas doc not found: $gotchas_doc" "Create $ICCULUS_ROOT/$gotchas_doc, or clear [project].gotchas_doc."
    fi
fi

# --- scope-gate commands resolve ------------------------------------------

for scope in $(config_subsections scopes); do
    gate_cmd=$(config_get "scopes.$scope.gate" "")
    [ -n "$gate_cmd" ] || continue
    resolve_cmd "scope gate '$scope'" "$gate_cmd"
done

# --- foreign tooling / layering -------------------------------------------
#
# The harness can be dropped onto a repo that already automates worktrees or
# already owns its agent-instruction files. Running alongside that other tool
# causes double setup/teardown or a clobbered CLAUDE.md. These are advisories
# (warn, exit 0): the install is fine, but the operator must reconcile by hand.
# Detection is textual (no jq / no parser) so it degrades gracefully everywhere.

# 1) Another worktree automation in .claude/settings.json. The harness's own
#    worktree hooks always invoke `./agent` (worktree / worktree:teardown /
#    worktree:ensure). If a worktree hook is present whose command does NOT
#    mention ./agent, a different tool owns that lifecycle here.
settings_json="$ICCULUS_ROOT/.claude/settings.json"
if [ -f "$settings_json" ]; then
    # Inspect each WorktreeCreate/WorktreeRemove hook COMMAND, not just whether
    # ./agent appears somewhere: after `init` merges, the harness's own hooks
    # (which all call ./agent) coexist with any the repo already had, so a
    # foreign hook is only visible per-command. Any worktree-lifecycle command
    # that does NOT call ./agent is a different tool's automation and would run
    # ALONGSIDE ours, doubling setup/teardown. jq parses it precisely (the
    # harness's own worktree hooks already require jq, so it is expected present);
    # without jq, fall back to the coarse "a worktree hook but no ./agent" test.
    foreign_hook=""
    if command -v jq >/dev/null 2>&1; then
        foreign_hook=$(jq -r '((.hooks.WorktreeCreate // []) + (.hooks.WorktreeRemove // []))[].hooks[]?.command // empty' "$settings_json" 2>/dev/null \
            | grep -v './agent' | head -n 1)
    elif grep -Eiq '"?Worktree(Create|Remove)"?[[:space:]]*:' "$settings_json" 2>/dev/null \
        && ! grep -q './agent' "$settings_json" 2>/dev/null; then
        foreign_hook="a worktree hook that does not call ./agent"
    fi
    if [ -n "$foreign_hook" ]; then
        add warn "Another tool also automates worktrees in .claude/settings.json (a hook command does not call ./agent)." "Both fire on worktree create/remove — reconcile the hooks by hand so setup/teardown isn't doubled."
    fi
fi

# 2) A CLAUDE.md owned by a different guideline compiler. `agent guidelines`
#    writes plain concatenated guideline text with NO banner, so a marker like
#    Laravel Boost's <laravel-boost-guidelines> wrapper or a `=== ... rules ===`
#    section banner means another compiler generated this file — and the next
#    `agent guidelines` run will overwrite it.
claude_md="$ICCULUS_ROOT/CLAUDE.md"
if [ -f "$claude_md" ]; then
    if grep -Eq '<laravel-boost-guidelines>|^===[[:space:]].*[[:space:]]rules[[:space:]]===' "$claude_md" 2>/dev/null; then
        add warn "CLAUDE.md looks generated by another tool (it carries a foreign compiler's banner)." "\`agent guidelines\` overwrites CLAUDE.md from .icculus/guidelines/* — move that tool's content into .icculus/guidelines/, or drop claude_code from [project].agents."
    fi
fi

# --- render ---------------------------------------------------------------

# Emit one JSON object array element per finding matching $1 (the level), from
# the report file. Used to build the errors/warnings/findings arrays.
emit_json_findings() {
    _ej_level=$1
    _ej_first=1
    while IFS="$(printf '\t')" read -r level message fix; do
        [ "$_ej_level" = "any" ] || [ "$_ej_level" = "$level" ] || continue
        [ "$_ej_first" -eq 1 ] && _ej_first=0 || printf ','
        _m=$(validate_json_escape "$message")
        _f=$(validate_json_escape "$fix")
        if [ "$_ej_level" = "any" ]; then
            printf '{"level":"%s","message":"%s","fix":"%s"}' "$level" "$_m" "$_f"
        else
            printf '{"message":"%s","fix":"%s"}' "$_m" "$_f"
        fi
    done < "$report"
}

if [ "$as_json" -eq 1 ]; then
    printf '{"ok":%s,"errors":[' "$([ "$had_failure" -eq 0 ] && printf 'true' || printf 'false')"
    emit_json_findings fail
    printf '],"warnings":['
    emit_json_findings warn
    printf '],"findings":['
    emit_json_findings any
    printf ']}\n'
else
    heading "Engine health check"
    while IFS="$(printf '\t')" read -r level message fix; do
        case "$level" in
            ok)   ok "$message" ;;
            warn) warn "$message"; [ -n "$fix" ] && printf '    %s%s%s\n' "$C_DIM" "$fix" "$C_RESET" >&2 ;;
            fail) printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$message" >&2; [ -n "$fix" ] && printf '    %s%s%s\n' "$C_DIM" "$fix" "$C_RESET" >&2 ;;
        esac
    done < "$report"

    # Summary line: distinguish a clean bill from advisories-only from broken.
    warn_count=$(awk -F"$(printf '\t')" '$1 == "warn"' "$report" | grep -c .)
    if [ "$had_failure" -ne 0 ]; then
        : # the failing lines above already carry their fixes; no extra summary
    elif [ "$warn_count" -gt 0 ]; then
        ok "Engine works, but $warn_count advisory warning(s) above are worth a look."
    else
        ok "Engine looks healthy."
    fi
fi

# Warnings are advisories (exit 0); only hard failures fail the command.
[ "$had_failure" -eq 0 ]
