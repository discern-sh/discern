#!/usr/bin/env bash
# helper: remove stale git worktrees and fully-merged branches (keeps live work)

# Remove stale Git worktrees and branches while keeping work worth reviewing.
#
# Honors GIT_BIN (default "git") and MAIN_BRANCH (default "main").

set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd -P)"

dry_run=false
assume_yes=false
include_detached=false

usage() {
    cat <<'USAGE'
Usage: prune-git-worktrees [options]

Remove stale Git worktrees and branches while keeping work worth reviewing.

Worktrees kept:
  - the main worktree
  - the worktree the script is invoked from
  - worktrees with staged, unstaged, or untracked changes
  - worktrees on a branch with commits not yet merged into main
  - locked worktrees

Branches kept:
  - main
  - branches checked out in any kept worktree
  - branches with commits not yet merged into main

Options:
  -n, --dry-run          Print what would happen without removing anything.
  -y, --yes              Remove candidates without prompting.
  --include-detached     Allow clean detached worktrees to be removed.
  -h, --help             Show this help text.
USAGE
}

while (($# > 0)); do
    case "$1" in
        -n | --dry-run)
            dry_run=true
            ;;
        -y | --yes)
            assume_yes=true
            ;;
        --include-detached)
            include_detached=true
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac

    shift
done

git_bin="${GIT_BIN:-git}"
main_branch="${MAIN_BRANCH:-main}"

if ! command -v "$git_bin" >/dev/null 2>&1; then
    echo "Unable to find git. Set GIT_BIN=/path/to/git or fix PATH." >&2
    exit 127
fi

repository_root="$("$git_bin" rev-parse --show-toplevel 2>/dev/null || true)"

if [[ -z "$repository_root" ]]; then
    echo "This command must be run from inside a Git repository." >&2
    exit 1
fi

cd "$repository_root"

if ! "$git_bin" show-ref --verify --quiet "refs/heads/$main_branch"; then
    echo "Expected local '$main_branch' branch to exist; aborting." >&2
    exit 1
fi

join_by() {
    local separator="$1"
    shift

    local joined=""
    local item

    for item in "$@"; do
        if [[ -z "$joined" ]]; then
            joined="$item"
            continue
        fi

        joined="${joined}${separator}${item}"
    done

    printf '%s' "$joined"
}

branch_is_merged() {
    local branch="$1"

    "$git_bin" merge-base --is-ancestor "refs/heads/$branch" "refs/heads/$main_branch"
}

# git branch -d compares against HEAD/upstream, which may not be main when this
# script is invoked from a feature branch. Re-verify against main and force.
delete_branch_safe() {
    local branch="$1"

    if ! branch_is_merged "$branch" 2>/dev/null; then
        echo "Refusing to delete $branch: not fully merged into $main_branch" >&2
        return 1
    fi

    "$git_bin" branch -D "$branch" >/dev/null
}

declare -a worktree_paths=()
declare -a worktree_branches=()
declare -a worktree_locked=()
declare -a worktree_prunable=()

current_path=""
current_branch=""
current_locked=false
current_prunable=false

append_worktree_record() {
    if [[ -z "$current_path" ]]; then
        return
    fi

    worktree_paths+=("$current_path")
    worktree_branches+=("$current_branch")
    worktree_locked+=("$current_locked")
    worktree_prunable+=("$current_prunable")

    current_path=""
    current_branch=""
    current_locked=false
    current_prunable=false
}

while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
        append_worktree_record
        continue
    fi

    case "$line" in
        worktree\ *)
            append_worktree_record
            current_path="${line#worktree }"
            ;;
        branch\ *)
            current_branch="${line#branch }"
            ;;
        locked*)
            current_locked=true
            ;;
        prunable*)
            current_prunable=true
            ;;
    esac
done < <("$git_bin" worktree list --porcelain)

append_worktree_record

main_worktree_path="${worktree_paths[0]:-}"

declare -a remove_candidates=()
declare -a remove_candidate_branches=()
declare -a delete_branches=()
scheduled_branches_set=""
stale_metadata_count=0

echo "Scanning worktrees in $repository_root"
echo

for index in "${!worktree_paths[@]}"; do
    worktree_path="${worktree_paths[$index]}"
    branch="${worktree_branches[$index]}"
    locked="${worktree_locked[$index]}"
    prunable="${worktree_prunable[$index]}"
    short_branch="${branch#refs/heads/}"

    if [[ "$prunable" == true ]]; then
        stale_metadata_count=$((stale_metadata_count + 1))
        printf 'PRUNE  %s (stale metadata)\n' "$worktree_path"
        continue
    fi

    if [[ "$worktree_path" == "$main_worktree_path" ]]; then
        printf 'KEEP   %s (main worktree)\n' "$worktree_path"
        continue
    fi

    if [[ "$worktree_path" == "$repository_root" ]]; then
        printf 'KEEP   %s (running from here)\n' "$worktree_path"
        continue
    fi

    declare -a keep_reasons=()

    if [[ "$locked" == true ]]; then
        keep_reasons+=("locked")
    fi

    if [[ -n "$short_branch" ]]; then
        if ! branch_is_merged "$short_branch" 2>/dev/null; then
            keep_reasons+=("branch ${short_branch} has unmerged commits")
        fi
    elif [[ "$include_detached" != true ]]; then
        keep_reasons+=("detached HEAD")
    fi

    status_exit=0
    status_output="$("$git_bin" -C "$worktree_path" status --porcelain --untracked-files=normal 2>&1)" || status_exit=$?

    if ((status_exit != 0)); then
        keep_reasons+=("status failed; skipped")
    elif [[ -n "$status_output" ]]; then
        change_count="$(printf '%s\n' "$status_output" | wc -l)"
        change_count="${change_count//[[:space:]]/}"
        keep_reasons+=("dirty ${change_count} status entries")
    fi

    if ((${#keep_reasons[@]} > 0)); then
        printf 'KEEP   %s (%s)\n' "$worktree_path" "$(join_by ', ' "${keep_reasons[@]}")"
        continue
    fi

    remove_candidates+=("$worktree_path")
    remove_candidate_branches+=("$short_branch")

    if [[ -n "$short_branch" ]]; then
        scheduled_branches_set="${scheduled_branches_set}|${short_branch}|"
        printf 'REMOVE %s (clean branch %s, fully merged)\n' "$worktree_path" "$short_branch"
    else
        printf 'REMOVE %s (clean detached)\n' "$worktree_path"
    fi
done

kept_worktree_branches_set=""

for index in "${!worktree_paths[@]}"; do
    branch="${worktree_branches[$index]}"
    short_branch="${branch#refs/heads/}"

    if [[ -z "$short_branch" ]]; then
        continue
    fi

    if [[ "$scheduled_branches_set" == *"|${short_branch}|"* ]]; then
        continue
    fi

    kept_worktree_branches_set="${kept_worktree_branches_set}|${short_branch}|"
done

echo
echo "Scanning branches in $repository_root"
echo

while IFS= read -r branch_name; do
    if [[ "$branch_name" == "$main_branch" ]]; then
        printf 'KEEP   %s (protected)\n' "$branch_name"
        continue
    fi

    if [[ "$kept_worktree_branches_set" == *"|${branch_name}|"* ]]; then
        printf 'KEEP   %s (checked out in a kept worktree)\n' "$branch_name"
        continue
    fi

    if [[ "$scheduled_branches_set" == *"|${branch_name}|"* ]]; then
        continue
    fi

    if branch_is_merged "$branch_name" 2>/dev/null; then
        delete_branches+=("$branch_name")
        scheduled_branches_set="${scheduled_branches_set}|${branch_name}|"
        printf 'DELETE %s (fully merged into %s)\n' "$branch_name" "$main_branch"
    else
        printf 'KEEP   %s (has unmerged commits)\n' "$branch_name"
    fi
done < <("$git_bin" for-each-ref --format='%(refname:short)' refs/heads)

echo

worktree_branch_count=0

for index in "${!remove_candidate_branches[@]}"; do
    [[ -n "${remove_candidate_branches[$index]}" ]] && worktree_branch_count=$((worktree_branch_count + 1))
done

total_branches_to_delete=$((worktree_branch_count + ${#delete_branches[@]}))

if [[ "$dry_run" == true ]]; then
    echo "Dry run complete."
    echo "Would remove ${#remove_candidates[@]} worktree(s) and delete ${total_branches_to_delete} branch(es)."

    if ((stale_metadata_count > 0)); then
        echo "Would also prune ${stale_metadata_count} stale metadata entr$( ((stale_metadata_count == 1)) && echo 'y' || echo 'ies' )."
    fi

    exit 0
fi

if ((${#remove_candidates[@]} == 0)) && ((${#delete_branches[@]} == 0)); then
    echo "Nothing to remove."
else
    if [[ "$assume_yes" != true ]]; then
        if [[ ! -t 0 ]]; then
            echo "Refusing to prune without an interactive prompt. Re-run with --yes." >&2
            exit 1
        fi

        read -r -p "Remove ${#remove_candidates[@]} worktree(s) and delete ${total_branches_to_delete} branch(es)? [y/N] " confirmation

        case "$confirmation" in
            y | Y | yes | YES)
                ;;
            *)
                echo "Aborted."
                exit 1
                ;;
        esac
    fi

    echo

    failed=false

    for index in "${!remove_candidates[@]}"; do
        worktree_path="${remove_candidates[$index]}"
        branch_to_delete="${remove_candidate_branches[$index]}"

        printf 'Removing %s... ' "$worktree_path"

        # Robust, leak-free removal: retries the transient ENOTEMPTY race and
        # falls back to rm -rf + prune so a failed delete never leaves a
        # multi-hundred-MB orphan behind (which the bare `git worktree remove`
        # used to do — see remove-worktree-safely).
        if "$script_dir/remove-worktree-safely" "$worktree_path"; then
            echo "done"

            if [[ -n "$branch_to_delete" ]]; then
                printf 'Deleting branch %s... ' "$branch_to_delete"

                if delete_branch_safe "$branch_to_delete"; then
                    echo "done"
                else
                    echo "failed"
                    failed=true
                fi
            fi
        else
            echo "failed"
            failed=true
        fi
    done

    for index in "${!delete_branches[@]}"; do
        branch_name="${delete_branches[$index]}"
        printf 'Deleting branch %s... ' "$branch_name"

        if delete_branch_safe "$branch_name"; then
            echo "done"
        else
            echo "failed"
            failed=true
        fi
    done

    if [[ "$failed" == true ]]; then
        echo "One or more cleanups failed." >&2
        exit 1
    fi
fi

printf 'Pruning stale worktree metadata... '

if "$git_bin" worktree prune; then
    echo "done"
else
    echo "failed"
    exit 1
fi

echo "Done."
