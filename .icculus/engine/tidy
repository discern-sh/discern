#!/usr/bin/env sh
# desc: fast inner loop — apply fixers, then run the read-only checks (no build/test)
. "$(dirname "$0")/lib/bootstrap.sh"

# tidy — run the fix-stage jobs, then the read-only check-stage jobs. The
# mutating fixers run first (serially, since order matters — one fixer's output
# is the next's input), then the read-only checks. It never builds or runs
# tests, so it stays fast enough for the inner loop. Fails non-zero if anything
# fails.

# cmds_in_stage joins a stage's jobs with ` && ` (in declaration order), so the
# fix stage runs serially as required.
fix_cmd=$(cmds_in_stage fix)
check_cmd=$(cmds_in_stage check)

heading "Fixing code..."
eval "$fix_cmd" || die "A fixer failed."

heading "Checking..."
eval "$check_cmd" || die "A check failed."

ok "Tidy complete — fixers applied and checks passed."
