#!/usr/bin/env sh
# desc: classify which scopes the branch + working tree touch (config-driven)
. "$(dirname "$0")/lib/bootstrap.sh"

# Scope patterns from [scopes] carry glob metacharacters ("app/**", "*.view") and
# are deliberately word-split unquoted in path_matches_scope below. Disable
# pathname expansion for the whole recipe so the shell never expands a pattern
# against the working tree: with globbing on, "app/**" collapses to the immediate
# children of app/, so nested paths (app/StarterVision/Scene/Foo.swift) match
# NOTHING and their scope silently never fires. set -f touches only filename
# generation — the case-pattern matching and ${var%...} trimming this recipe
# relies on are unaffected. Do not remove without re-quoting every split below.
set -f

# changed-scopes [--has <scope>] [--json]
#
# Classifies changed paths against the [scopes] config. It answers
# "what parts of the repo did this branch change?" so `finish` can skip scope
# gates and the preview line for areas that did not change. Classification fails
# OPEN: when git cannot answer, every scope is reported, so consumers run MORE
# gates, never fewer.
#
# Each scope is a [scopes.<name>] table in .icculus/config.toml:
#   paths        the globs that define the scope (required)
#   neutral      true: changes here need no gate (docs, agent guidance). A scope
#                flagged neutral never fires; root-level *.md is always neutral.
#   previewable  true: a person could see changes here — worth a preview link.
#   gate         a command `finish` runs when this scope changed (optional).
#
# Two derived markers are emitted alongside scope names:
#   code         any non-neutral path (a real, gated change; the fail-open
#                default — a path matching no scope still counts as code).
#   previewable  emitted when a previewable-flagged scope changed.
#
# Output:
#   (default)        one scope/marker per line, in a stable order
#   --has <name>     exit 0 if that scope/marker is present, 1 if absent (silent)
#   --json           a JSON array of the present scopes/markers
#
# Glob kinds, per `paths` entry:
#   prefix            "src/**" or "src/"        -> path starts with "src/"
#   exact             "routes/web.php"          -> path equals it
#   suffix            "*.view"                  -> path ends with ".view"
#   segment-contains  "/ui/"                    -> path contains "/ui/"

# --- argument parsing -----------------------------------------------------

want=""
as_json=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --has)
            shift
            [ "$#" -ge 1 ] || die "changed-scopes: --has needs a scope name."
            want=$1
            ;;
        --has=*)
            want=${1#--has=}
            ;;
        --json)
            as_json=1
            ;;
        -h|--help)
            printf 'Usage: changed-scopes [--has <scope>] [--json]\n'
            exit 0
            ;;
        *)
            die "changed-scopes: unknown argument '$1'."
            ;;
    esac
    shift
done

# --- which scopes exist, and their roles ----------------------------------

# Read the scope subtables once. A scope flagged `neutral` marks paths that need
# no gate (it never fires); every other scope is a code region that fires by name
# when one of its globs matches (so its optional gate runs). Declaration order is
# preserved for stable output.
neutral_scopes=""
fire_scopes=""
for _key in $(config_subsections scopes); do
    if config_bool "scopes.$_key.neutral"; then
        neutral_scopes="$neutral_scopes $_key"
    else
        fire_scopes="$fire_scopes $_key"
    fi
done

# --- gather changed paths (fail open) -------------------------------------

# Base branch: env override first (the MAIN_BRANCH variable), else "main".
main_branch=${MAIN_BRANCH:-main}
git_bin=${GIT_BIN:-git}

# Emit every possible scope/marker — used when we cannot tell what changed, so
# callers err toward running more gates. Markers first, then every firing scope.
emit_all_scopes() {
    printf 'code\n'
    printf 'previewable\n'
    for _s in $fire_scopes; do
        printf '%s\n' "$_s"
    done
}

# Collect the branch's changed paths to a temp file, one per line. Returns
# non-zero (fail open) when git is unavailable or cannot produce a diff base.
collect_paths() {
    command -v "$git_bin" >/dev/null 2>&1 || return 1

    # Committed since the merge-base with main, plus the working tree (staged,
    # unstaged, untracked). Either git failure means "cannot tell" -> fail open.
    _committed=$("$git_bin" diff --name-only "$main_branch...HEAD" 2>/dev/null) || return 1
    _pending=$("$git_bin" status --porcelain=v1 --untracked-files=all 2>/dev/null) || return 1

    {
        printf '%s\n' "$_committed"
        # Porcelain v1 lines are "XY <path>" and renames "XY <old> -> <new>";
        # strip the 3-char status prefix, then keep the post-arrow path.
        printf '%s\n' "$_pending" | while IFS= read -r _line; do
            [ -n "$_line" ] || continue
            _p=$(printf '%s' "$_line" | cut -c4-)
            case "$_p" in
                *' -> '*) _p=${_p##* -> } ;;
            esac
            # Drop any wrapping quotes git adds for unusual paths.
            _p=$(printf '%s' "$_p" | sed 's/^"//; s/"$//')
            [ -n "$_p" ] && printf '%s\n' "$_p"
        done
    }
}

# --- glob matching --------------------------------------------------------

# Does $path match the single $pattern? Implements the four pattern kinds.
# Branch ORDER matters: a segment pattern ("/ui/") both starts and ends with a
# slash, so it must be tested BEFORE the trailing-slash prefix kind ("src/"),
# which would otherwise swallow it and treat "/ui/" as a prefix that no nested
# path ("app/ui/x") begins with.
path_matches_pattern() {
    _pm_path=$1
    _pm_pat=$2
    [ -n "$_pm_pat" ] || return 1

    case "$_pm_pat" in
        */\*\*)
            # "src/**" -> prefix on "src/"
            _pm_pre=${_pm_pat%\*\*}
            case "$_pm_path" in "$_pm_pre"*) return 0 ;; esac
            ;;
        /*/)
            # "/ui/" -> segment-contains (starts AND ends with a slash)
            case "$_pm_path" in *"$_pm_pat"*) return 0 ;; esac
            ;;
        */)
            # "src/" -> prefix (ends with a slash but does not start with one)
            case "$_pm_path" in "$_pm_pat"*) return 0 ;; esac
            ;;
        \*.*)
            # "*.view" -> suffix on ".view"
            _pm_suf=${_pm_pat#\*}
            case "$_pm_path" in *"$_pm_suf") return 0 ;; esac
            ;;
        *)
            # No glob marker: exact path match.
            [ "$_pm_path" = "$_pm_pat" ] && return 0
            ;;
    esac
    return 1
}

# Does $path match ANY glob in the given scope's `paths` array?
path_matches_scope() {
    _ms_path=$1
    _ms_key=$2
    for _ms_pat in $(config_array "scopes.$_ms_key.paths"); do
        if path_matches_pattern "$_ms_path" "$_ms_pat"; then
            return 0
        fi
    done
    return 1
}

# A path is neutral if it matches any neutral-flagged scope's paths, OR it is a
# root-level markdown file (README.md, AGENTS.md, …). Markdown nested in a code
# directory still counts for that directory's scope.
path_is_neutral() {
    _pn_path=$1
    for _pn_s in $neutral_scopes; do
        path_matches_scope "$_pn_path" "$_pn_s" && return 0
    done
    case "$_pn_path" in
        */*) return 1 ;;                 # nested -> not a root-level doc
        *.md) return 0 ;;
    esac
    return 1
}

# --- classify -------------------------------------------------------------

scopes_file=$(mktemp "${TMPDIR:-/tmp}/icculus-scopes.XXXXXX") || die "changed-scopes: mktemp failed."
paths_file=$(mktemp "${TMPDIR:-/tmp}/icculus-paths.XXXXXX") || die "changed-scopes: mktemp failed."
# shellcheck disable=SC2064
trap "rm -f '$scopes_file' '$paths_file'" EXIT INT TERM

if ! collect_paths > "$paths_file" 2>/dev/null; then
    # Fail open: git can't tell us what changed -> report every scope.
    emit_all_scopes > "$scopes_file"
else
    have_code=0
    have_previewable=0
    # Track which firing scopes matched, space-delimited with surrounding spaces.
    fired=" "

    while IFS= read -r path; do
        # Normalise: trim surrounding whitespace and a single leading slash.
        path=$(printf '%s' "$path" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s#^/##')
        [ -n "$path" ] || continue
        path_is_neutral "$path" && continue

        # Any non-neutral path is a real, gated change.
        have_code=1

        for _fs in $fire_scopes; do
            case "$fired" in
                *" $_fs "*) continue ;;   # already recorded
            esac
            if path_matches_scope "$path" "$_fs"; then
                fired="$fired$_fs "
                config_bool "scopes.$_fs.previewable" && have_previewable=1
            fi
        done
    done < "$paths_file"

    # Emit in stable order: the code marker, the previewable marker, then firing
    # scopes in declaration order (only those that actually matched).
    {
        [ "$have_code" -eq 1 ] && printf 'code\n'
        [ "$have_previewable" -eq 1 ] && printf 'previewable\n'
        for _fs in $fire_scopes; do
            case "$fired" in
                *" $_fs "*) printf '%s\n' "$_fs" ;;
            esac
        done
    } > "$scopes_file"
fi

# --- output ---------------------------------------------------------------

# --has <scope>: exit status only, no output.
if [ -n "$want" ]; then
    if grep -qx "$want" "$scopes_file"; then
        exit 0
    fi
    exit 1
fi

if [ "$as_json" -eq 1 ]; then
    # Build a compact JSON array without assuming jq is present.
    _json="["
    _first=1
    while IFS= read -r _s; do
        [ -n "$_s" ] || continue
        if [ "$_first" -eq 1 ]; then
            _first=0
        else
            _json="$_json,"
        fi
        _json="$_json\"$_s\""
    done < "$scopes_file"
    _json="$_json]"
    printf '%s\n' "$_json"
    exit 0
fi

cat "$scopes_file"
