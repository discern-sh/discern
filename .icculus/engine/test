#!/usr/bin/env sh
# desc: run the test capability
. "$(dirname "$0")/lib/bootstrap.sh"

# test — a convenience over the `test` capability. `agent finish` runs it in
# parallel with the read-only checks; this runs just the tests, on demand.

test_cmd=$(cmds_in_stage test)

if [ "$test_cmd" = ":" ]; then
    info "No test capability is configured (set test = \"<command>\" under [capabilities] in .icculus/config.toml)."
    exit 0
fi

heading "Running tests..."
eval "$test_cmd" || die "Tests failed."
ok "Tests passed."
