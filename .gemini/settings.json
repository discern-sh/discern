{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "discern worktree ensure"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "discern": {
      "command": "discern",
      "args": [
        "mcp",
        "--long-tool-calls"
      ],
      "timeout": 3600000
    }
  },
  "hooksConfig": {
    "enabled": true
  }
}
