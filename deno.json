{
  "name": "icculus",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-env --allow-run src/main.ts",
    "build": "deno run --allow-read --allow-write --allow-env --allow-run scripts/build.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "coverage": "deno run --allow-read --allow-write --allow-env --allow-run scripts/coverage.ts",
    "check": "deno check src/main.ts",
    "gate": "deno task dev finish"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.0.0-rc.8",
    "@cliffy/table": "jsr:@cliffy/table@^1.0.0-rc.8",
    "@cliffy/ansi/colors": "jsr:@cliffy/ansi@^1.0.0-rc.8/colors",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.13",
    "@std/encoding/hex": "jsr:@std/encoding@^1.0.7/hex",
    "@std/toml": "jsr:@std/toml@^1.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.10"
  },
  "fmt": {
    "exclude": [
      "templates/",
      "dist/",
      "tests/fixtures/",
      "PLAN.md",
      ".icculus/",
      ".claude/",
      "AGENTS.md",
      "CLAUDE.md",
      ".idea/"
    ]
  },
  "lint": {
    "rules": {
      "include": [
        "eqeqeq",
        "no-throw-literal",
        "explicit-function-return-type",
        "verbatim-module-syntax"
      ]
    },
    "exclude": [
      "templates/",
      "dist/",
      "tests/fixtures/",
      ".icculus/",
      ".claude/"
    ]
  },
  "test": {
    "exclude": [".claude/", "dist/", "templates/", "tests/fixtures/"]
  }
}
