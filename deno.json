{
  "name": "discern",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-env --allow-run src/main.ts",
    "build": "deno run --allow-read --allow-write --allow-env --allow-run scripts/build.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --parallel",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "coverage": "deno run --allow-read --allow-write --allow-env --allow-run scripts/coverage.ts",
    "prose": "deno run --allow-read --allow-env --allow-run scripts/prose.ts",
    "codegen": "deno run --allow-read --allow-write scripts/codegen.ts",
    "inspect-mcp": "deno run --allow-read --allow-run scripts/inspect_mcp.ts",
    "install-dev-cli": "deno run --allow-read --allow-write --allow-env --allow-run scripts/install_dev_cli.ts",
    "check": "deno check",
    "gate": "deno task dev finish"
  },
  "imports": {
    "@modelcontextprotocol/sdk/server/mcp.js": "npm:@modelcontextprotocol/sdk@^1.29.0/server/mcp.js",
    "@modelcontextprotocol/sdk/server/stdio.js": "npm:@modelcontextprotocol/sdk@^1.29.0/server/stdio.js",
    "process": "node:process",
    "@zod/zod": "jsr:@zod/zod@^4.4.3",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.0.0-rc.8",
    "@cliffy/table": "jsr:@cliffy/table@^1.0.0-rc.8",
    "@cliffy/ansi/colors": "jsr:@cliffy/ansi@^1.0.0-rc.8/colors",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.13",
    "@std/encoding/hex": "jsr:@std/encoding@^1.0.7/hex",
    "@std/toml": "jsr:@std/toml@^1.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.10"
  },
  "fmt": {
    "exclude": [
      ".claude/",
      ".discern-help-docs/",
      ".idea/",
      "AGENTS.md",
      "brief.md",
      "CLAUDE.md",
      "discern.toml",
      "dist/",
      "docs/10-installer/config-reference.md",
      "GEMINI.md",
      "PLAN.md",
      "schema/discern-config.schema.json",
      "templates/",
      "tests/fixtures/"
    ]
  },
  "lint": {
    "rules": {
      "include": [
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-eval",
        "no-external-import",
        "no-node-globals",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-process-global",
        "no-self-compare",
        "no-slow-types",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename",
        "single-var-declarator",
        "verbatim-module-syntax"
      ]
    },
    "exclude": [
      ".claude/",
      ".discern-help-docs/",
      "dist/",
      "templates/",
      "tests/fixtures/"
    ]
  },
  "test": {
    "exclude": [
      ".claude/",
      ".discern-help-docs/",
      "dist/",
      "templates/",
      "tests/fixtures/"
    ]
  }
}
