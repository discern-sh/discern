{
  "name": "discern",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "license": "FSL-1.1-ALv2",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@discern-sh/design-system"]
  },
  "deploy": {
    "build": "deno task site:build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "site/main.ts"
    }
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "npm:@types/react@18.3.12",
      "npm:@types/react-dom@18.3.1"
    ]
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-env --allow-run src/main.ts",
    "build": "deno run --allow-read --allow-write --allow-env --allow-run scripts/build.ts",
    "art": "deno run --allow-env=TERM,COLORTERM,LC_ALL,LC_CTYPE,LANG,COLUMNS,LINES,COLORFGBG,NO_COLOR,CI scripts/art.ts",
    "terminal:capture": "deno run --allow-read --allow-write --allow-env --allow-run scripts/terminal_capture.ts",
    "terminal:capture-fixtures": "deno run --allow-read --allow-write --allow-env --allow-run scripts/terminal_capture_fixtures.ts",
    "terminal:review": "deno run --allow-read --allow-net=127.0.0.1 scripts/terminal_review.ts",
    "test:preflight": "deno run --allow-net=127.0.0.1 scripts/test_preflight.ts",
    "test": "discern queue -- deno run --allow-read --allow-env --allow-run --allow-net=127.0.0.1 scripts/run_tests.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "ambient-boundaries": "deno run scripts/ambient_state_boundary_counts.ts",
    "cast-census": "deno run --allow-read --allow-run=git scripts/cast_census.ts",
    "duplication-census": "deno run --allow-read --allow-run=git scripts/duplication_census.ts",
    "lint-suppressions": "deno run --allow-read --allow-run=git scripts/lint_suppressions.ts",
    "silent-error-boundaries": "deno run --allow-read --allow-run=git scripts/silent_error_boundaries.ts",
    "subprocess-spawn-boundaries": "deno run --allow-read --allow-run=git scripts/subprocess_spawn_boundaries.ts",
    "process-boundaries": "deno run --allow-read --allow-run=git scripts/process_boundaries.ts",
    "promise-effects": "deno run --allow-read --allow-run=deno,git scripts/promise_effects.ts",
    "test-real-delay-boundaries": "deno run --allow-read --allow-run=git scripts/test_real_delay_boundaries.ts",
    "coverage": "deno run --allow-read --allow-write --allow-env --allow-run scripts/coverage.ts",
    "prose": "deno run --allow-read --allow-write --allow-env --allow-run scripts/prose.ts",
    "vale:sync": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net=github.com,release-assets.githubusercontent.com scripts/vale_toolchain.ts",
    "vocab": "deno run --allow-read --allow-env scripts/vocab_signals.ts",
    "codegen": "deno run --allow-read --allow-write --allow-run=deno,git --allow-net=jsr.io --allow-env=DISCERN_TEMPLATES_DIR scripts/codegen.ts",
    "inspect-mcp": "deno run --allow-read --allow-run scripts/inspect_mcp.ts",
    "install-dev-cli": "deno run --allow-read --allow-write --allow-env --allow-run scripts/install_dev_cli.ts",
    "use-compiled-build": "deno run --allow-read --allow-write --allow-env --allow-run scripts/use_compiled_build.ts",
    "check": "deno check",
    "gate": "deno task dev done",
    "canon-editor": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1 scripts/canon_editor/main.ts",
    "site:build": "deno run --allow-read --allow-write --allow-run --allow-env=NODE_ENV site/build.ts",
    "site:prose": "deno run --allow-read --allow-write --allow-run --allow-env scripts/site_prose.ts",
    "site:prose-check": "deno run --allow-read --allow-write --allow-run --allow-env scripts/site_prose_check.ts",
    "site:reading-grade": "deno run --allow-read --allow-env scripts/site_reading_grade.ts",
    "site:agents-words": "deno run --allow-read --allow-env scripts/agents_page_words.ts",
    "site:component-coverage": "deno run --allow-read --allow-write --allow-run --allow-env=NODE_ENV scripts/site_component_coverage.ts",
    "site:smoke": "deno task site:build && deno run --allow-read --allow-env --allow-net=127.0.0.1 scripts/site_smoke.ts --self-host",
    "site": "deno run --allow-read --allow-run --allow-net=127.0.0.1 --allow-env=PORT,DISCERN_PROJECT_SLUG,DISCERN_WORKTREE_BRANCH_PREFIX,DISCERN_WORKTREE_ID,GIT_BIN site/dev.ts",
    "site:specimens": "deno run --allow-read --allow-run --allow-net=127.0.0.1 --allow-env=NODE_ENV,PORT,DISCERN_PROJECT_SLUG,DISCERN_WORKTREE_BRANCH_PREFIX,DISCERN_WORKTREE_ID,GIT_BIN site/specimens.ts",
    "site:art": "deno task site:specimens",
    "watch": "deno run --watch --allow-read --allow-run --allow-net=127.0.0.1 --allow-env=PORT,DISCERN_PROJECT_SLUG,DISCERN_WORKTREE_BRANCH_PREFIX,DISCERN_WORKTREE_ID,GIT_BIN site/dev.ts --watch"
  },
  "imports": {
    "/assets/scheduler.js": "./site/pages/assets/scheduler.js",
    "@dprint/formatter": "npm:@dprint/formatter@0.5.1",
    "@modelcontextprotocol/sdk/server/mcp.js": "npm:@modelcontextprotocol/sdk@^1.29.0/server/mcp.js",
    "@modelcontextprotocol/sdk/server/stdio.js": "npm:@modelcontextprotocol/sdk@^1.29.0/server/stdio.js",
    "process": "node:process",
    "async_hooks": "node:async_hooks",
    "os": "node:os",
    "fs": "node:fs",
    "fs/promises": "node:fs/promises",
    "ts-morph": "jsr:@ts-morph/ts-morph@^28.0.0",
    "zlib": "node:zlib",
    "@zod/zod": "jsr:@zod/zod@^4.4.3",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
    "@std/fmt/bytes": "jsr:@std/fmt@^1.0.10/bytes",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.10/colors",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/path/posix": "jsr:@std/path@^1.0.8/posix",
    "@std/fs": "jsr:@std/fs@^1.0.13",
    "@std/encoding/base64": "jsr:@std/encoding@^1.0.7/base64",
    "@std/encoding/hex": "jsr:@std/encoding@^1.0.7/hex",
    "@std/toml": "jsr:@std/toml@^1.0.2",
    "@std/yaml": "jsr:@std/yaml@^1.0.5",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/testing/time": "jsr:@std/testing@^1.0.19/time",
    "axe-core": "npm:axe-core@4.10.3",
    "jsdom": "npm:jsdom@26.1.0",
    "@types/jsdom": "npm:@types/jsdom@21.1.7",
    "mdast-util-from-markdown": "npm:mdast-util-from-markdown@2.0.3",
    "mdast-util-gfm": "npm:mdast-util-gfm@3.1.0",
    "micromark-extension-gfm": "npm:micromark-extension-gfm@3.0.0",
    "playwright-core": "npm:playwright-core@1.61.1",
    "ajv-2020": "npm:ajv@^8.20.0/dist/2020.js",
    "react": "npm:react@18.3.1",
    "react/jsx-runtime": "npm:react@18.3.1/jsx-runtime",
    "react-dom/client": "npm:react-dom@18.3.1/client",
    "react-dom/server": "npm:react-dom@18.3.1/server",
    "discern-design-system": "jsr:@discern-sh/design-system@0.27.0"
  },
  "fmt": {
    "proseWrap": "never",
    "exclude": [
      ".claude/",
      ".discern-bundled-docs/",
      ".idea/",
      "AGENTS.md",
      "brief.md",
      "CLAUDE.md",
      "discern.toml",
      "dist/",
      "GEMINI.md",
      "PLAN.md",
      "project/TODO.md",
      "project/instructions.md",
      "project/map/**",
      "project/skills/",
      "schema/discern-config.schema.json",
      "templates/skills/",
      "tests/fixtures/"
    ]
  },
  "lint": {
    "plugins": [
      "./scripts/ambient_state_lint.ts",
      "./scripts/error_cause_lint.ts",
      "./scripts/function_docblock_lint.ts",
      "./scripts/silent_catch_lint.ts"
    ],
    "rules": {
      "include": [
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-eval",
        "no-external-import",
        "no-import-prefix",
        "no-node-globals",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-process-global",
        "no-self-compare",
        "no-slow-types",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename",
        "react-no-danger",
        "react-rules-of-hooks",
        "single-var-declarator",
        "verbatim-module-syntax"
      ]
    },
    "exclude": [
      ".claude/",
      ".discern-bundled-docs/",
      "dist/",
      "site/build.ts",
      "site/page-src/",
      "templates/",
      "tests/fixtures/"
    ]
  },
  "test": {
    "exclude": [
      ".claude/",
      ".discern-bundled-docs/",
      "dist/",
      "templates/",
      "tests/fixtures/"
    ]
  }
}
