{
  "name": "icculus",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-env --allow-run src/main.ts",
    "build": "deno run --allow-read --allow-write --allow-env --allow-run scripts/build.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "lint:sh": "deno run --allow-read --allow-run=shellcheck scripts/lint-sh.ts",
    "check": "deno check src/main.ts",
    "selfsync": "deno run --allow-read --allow-write --allow-env --allow-run src/main.ts upgrade --allow-dirty",
    "selfcheck": "deno run --allow-read --allow-write --allow-env --allow-run src/main.ts upgrade --check",
    "gate": "./bin/agent finish"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.0.0-rc.8",
    "@cliffy/ansi/colors": "jsr:@cliffy/ansi@^1.0.0-rc.8/colors",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.13",
    "@std/encoding/hex": "jsr:@std/encoding@^1.0.7/hex",
    "@std/toml": "jsr:@std/toml@^1.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.10"
  },
  "fmt": {
    "exclude": [
      "templates/",
      "dist/",
      "tests/fixtures/",
      "PLAN.md",
      ".icculus/",
      ".ai/",
      "AGENTS.md",
      "CLAUDE.md",
      ".idea/"
    ]
  },
  "lint": {
    "exclude": ["templates/", "dist/", "tests/fixtures/", ".icculus/", ".ai/"]
  }
}
