{
  "$schema": "../../../../schema/discern-config.schema.json",
  "version": "2",
  "description": "A FAKE example preset (a toy 'stack') — exists only to exercise the preset contract end-to-end in tests. Not a real ecosystem; not shipped.",
  "jobs": {
    "test": "echo running example tests",
    "examplecheck": {
      "stage": "check",
      "run": "echo example check",
      "provides": "example-check"
    }
  },
  "scopes": {
    "example": { "paths": ["example/**"], "gate": "echo example side gate" }
  },
  "standards": {
    "examplesize": {
      "direction": "down",
      "limit": 1000,
      "run": "echo 'DISCERN_METRIC examplesize 500'"
    }
  }
}
