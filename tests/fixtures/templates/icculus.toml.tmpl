# Fixture config for "{{project_name}}" generated by icculus {{kit_version}}.
[meta]
schema_version = 6

[project]
slug = "{{project_slug}}"
branch_prefix = "{{branch_prefix}}"

[features]
worktrees = true

[guidance]
agents = [{{agents_array}}]

[scopes.docs]
paths   = [{{scopes_neutral}}]
neutral = true

[worktree.db]
# @db@ is a runtime token (different delimiter): the installer must leave it
# untouched — the worktree engine expands it per-worktree.
clone = "createdb @db@"

# Drift probe: this token is not in the known set and must be left verbatim.
custom = "{{unknown_token}}"
